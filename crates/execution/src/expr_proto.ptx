    xor.b64 %mix, %mix, %tmp;
    mul.lo.u64 %mix, %mix, 0xff51afd7ed558ccd;
    shr.u64 %tmp, %mix, 33;
    xor.b64 %mix, %mix, %tmp;
    mul.lo.u64 %mix, %mix, 0xc4ceb9fe1a85ec53;
    shr.u64 %tmp, %mix, 33;
    xor.b64 %mix, %mix, %tmp;
    and.b64 %h, %mix, %mask;
    mov.u64 %clo, 0;
