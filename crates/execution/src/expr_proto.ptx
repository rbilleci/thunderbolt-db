.version 8.4
.target sm_90
.address_size 64

// Prototype primitives for the GENERAL GPU executor (docs/architecture/17-general-gpu-executor.md).
// These prove the buffer->buffer model a vectorized Expr interpreter needs: an interior Expr node
// (e.g. a+b) writes an INTERMEDIATE device buffer, not a resident payload column, and a later node
// consumes that buffer. Two composable primitives; the interpreter chains them. Pure ASCII (the
// runtime JIT rejects non-ASCII PTX even in comments).

// out[i] = a[i] <op> b[i] over two resident int4 columns into a leased intermediate buffer.
// op_code: 0=add, 1=sub, 2=mul. Grid-stride. `resident_ptr` is the payload base; columns are at
// resident_ptr + a_byte_offset / + b_byte_offset (i32, row-major). `out_ptr` is an absolute
// (leased) buffer of n*4 bytes. CHECKED int4 arithmetic (Postgres `integer out of range`): each op
// is evaluated in 64-bit and range-checked against the int32 bounds; an out-of-range result ORs 1
// into out_overflow_ptr[0] (the host raises the error). The stored i32 is the wrapped low-32-bit
// result, only consumed when no row overflowed.
.visible .entry gpu_db_resident_i32_binary_elementwise(
    .param .u64 resident_ptr,
    .param .u64 a_byte_offset,
    .param .u64 b_byte_offset,
    .param .u64 n,
    .param .u32 op_code,
    .param .u64 out_ptr,
    .param .u64 out_overflow_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_sub;
    .reg .pred %p_mul;
    .reg .pred %p_hi;
    .reg .pred %p_lo;
    .reg .pred %p_ovf;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %op;
    .reg .b32 %one;
    .reg .s32 %va;
    .reg .s32 %vb;
    .reg .s32 %vr;
    .reg .s64 %da;
    .reg .s64 %db;
    .reg .s64 %dr;
    .reg .s64 %dtmp;
    .reg .u64 %res;
    .reg .u64 %abase;
    .reg .u64 %bbase;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %ovf;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %res, [resident_ptr];
    ld.param.u64 %abase, [a_byte_offset];
    ld.param.u64 %bbase, [b_byte_offset];
    ld.param.u64 %n, [n];
    ld.param.u32 %op, [op_code];
    ld.param.u64 %out, [out_ptr];
    ld.param.u64 %ovf, [out_overflow_ptr];
    mov.b32 %one, 1;
    add.u64 %abase, %res, %abase;
    add.u64 %bbase, %res, %bbase;
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_ew:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_ew;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %abase, %o4;
    ld.global.s32 %va, [%addr];
    add.u64 %addr, %bbase, %o4;
    ld.global.s32 %vb, [%addr];
    cvt.s64.s32 %da, %va;
    cvt.s64.s32 %db, %vb;
    add.s64 %dr, %da, %db;
    setp.eq.u32 %p_sub, %op, 1;
    sub.s64 %dtmp, %da, %db;
    @%p_sub mov.b64 %dr, %dtmp;
    setp.eq.u32 %p_mul, %op, 2;
    mul.lo.s64 %dtmp, %da, %db;
    @%p_mul mov.b64 %dr, %dtmp;
    setp.gt.s64 %p_hi, %dr, 2147483647;
    setp.lt.s64 %p_lo, %dr, -2147483648;
    or.pred %p_ovf, %p_hi, %p_lo;
    @%p_ovf red.global.or.b32 [%ovf], %one;
    cvt.s32.s64 %vr, %dr;
    add.u64 %addr, %out, %o4;
    st.global.s32 [%addr], %vr;
    add.u64 %i, %i, %stride;
    bra loop_ew;
done_ew:
    ret;
}

// Compare an int4 INTERMEDIATE buffer to a scalar and append the matching row indices to
// out_indices via an atomic counter at out_count_ptr[0]. comparison: 0=eq,1=lt,2=le,3=gt,4=ge.
// Order is atomic-schedule (non-deterministic); the host sorts the returned indices for
// determinism (mirrors gpu_db_resident_i32_equal_row_indices). out_indices capacity is n*4 bytes,
// out_count_ptr is a single u32 pre-zeroed by the caller.
.visible .entry gpu_db_buffer_i32_compare_to_indices(
    .param .u64 in_ptr,
    .param .u64 n,
    .param .s32 needle,
    .param .u32 comparison,
    .param .u64 out_count_ptr,
    .param .u64 out_indices_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_eq;
    .reg .pred %p_lt;
    .reg .pred %p_le;
    .reg .pred %p_gt;
    .reg .pred %p_ge;
    .reg .pred %c_eq;
    .reg .pred %c_lt;
    .reg .pred %c_le;
    .reg .pred %c_gt;
    .reg .pred %c_ge;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %cmp;
    .reg .u32 %pos;
    .reg .u32 %iu;
    .reg .s32 %needle;
    .reg .s32 %v;
    .reg .u64 %in;
    .reg .u64 %n;
    .reg .u64 %count;
    .reg .u64 %outidx;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %in, [in_ptr];
    ld.param.u64 %n, [n];
    ld.param.s32 %needle, [needle];
    ld.param.u32 %cmp, [comparison];
    ld.param.u64 %count, [out_count_ptr];
    ld.param.u64 %outidx, [out_indices_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_cmp:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_cmp;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %in, %o4;
    ld.global.s32 %v, [%addr];
    setp.eq.s32 %p_eq, %v, %needle;
    setp.lt.s32 %p_lt, %v, %needle;
    setp.le.s32 %p_le, %v, %needle;
    setp.gt.s32 %p_gt, %v, %needle;
    setp.ge.s32 %p_ge, %v, %needle;
    setp.eq.u32 %c_eq, %cmp, 0;
    setp.eq.u32 %c_lt, %cmp, 1;
    setp.eq.u32 %c_le, %cmp, 2;
    setp.eq.u32 %c_gt, %cmp, 3;
    setp.eq.u32 %c_ge, %cmp, 4;
    mov.pred %match, 0;
    and.pred %p_eq, %p_eq, %c_eq;
    or.pred %match, %match, %p_eq;
    and.pred %p_lt, %p_lt, %c_lt;
    or.pred %match, %match, %p_lt;
    and.pred %p_le, %p_le, %c_le;
    or.pred %match, %match, %p_le;
    and.pred %p_gt, %p_gt, %c_gt;
    or.pred %match, %match, %p_gt;
    and.pred %p_ge, %p_ge, %c_ge;
    or.pred %match, %match, %p_ge;
    @!%match bra next_cmp;
    atom.global.add.u32 %pos, [%count], 1;
    cvt.u32.u64 %iu, %i;
    mul.lo.u32 %t32, %pos, 4;
    cvt.u64.u32 %addr, %t32;
    add.u64 %addr, %outidx, %addr;
    st.global.u32 [%addr], %iu;
next_cmp:
    add.u64 %i, %i, %stride;
    bra loop_cmp;
done_cmp:
    ret;
}

// ---- Recursive interpreter (device bytecode VM) primitives, docs/architecture/17 section 2.3 ----
// These let the VM evaluate an ARBITRARY int4 arithmetic tree by chaining buffer->buffer ops over
// leased intermediates: load a column into a buffer, then combine buffers (or a buffer and an
// immediate literal) elementwise. Arbitrary depth lowers to a postfix program of these. op_code:
// 0=add, 1=sub, 2=mul.

// out[i] = column[i] : load a resident int4 column (at resident_ptr + byte_offset) into a buffer.
.visible .entry gpu_db_resident_i32_load_column(
    .param .u64 resident_ptr,
    .param .u64 byte_offset,
    .param .u64 n,
    .param .u64 out_ptr
)
{
    .reg .pred %p;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .s32 %v;
    .reg .u64 %src;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %src, [resident_ptr];
    ld.param.u64 %addr, [byte_offset];
    add.u64 %src, %src, %addr;
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_ld:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_ld;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %src, %o4;
    ld.global.s32 %v, [%addr];
    add.u64 %addr, %out, %o4;
    st.global.s32 [%addr], %v;
    add.u64 %i, %i, %stride;
    bra loop_ld;
done_ld:
    ret;
}

// out[i] = a[i] <op> b[i] : elementwise binary over two intermediate buffers (absolute ptrs).
// CHECKED int4 arithmetic: each op is evaluated in 64-bit and range-checked; an int4-overflowing
// result ORs 1 into out_overflow_ptr[0] (Postgres `integer out of range`). Stored i32 is wrapped.
.visible .entry gpu_db_buffer_i32_binary(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u32 op_code,
    .param .u64 n,
    .param .u64 out_ptr,
    .param .u64 out_overflow_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_sub;
    .reg .pred %p_mul;
    .reg .pred %p_hi;
    .reg .pred %p_lo;
    .reg .pred %p_ovf;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %op;
    .reg .b32 %one;
    .reg .s32 %va;
    .reg .s32 %vb;
    .reg .s32 %vr;
    .reg .s64 %da;
    .reg .s64 %db;
    .reg .s64 %dr;
    .reg .s64 %dtmp;
    .reg .u64 %a;
    .reg .u64 %b;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %ovf;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.u64 %b, [b_ptr];
    ld.param.u32 %op, [op_code];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_ptr];
    ld.param.u64 %ovf, [out_overflow_ptr];
    mov.b32 %one, 1;
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_bb:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_bb;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %a, %o4;
    ld.global.s32 %va, [%addr];
    add.u64 %addr, %b, %o4;
    ld.global.s32 %vb, [%addr];
    cvt.s64.s32 %da, %va;
    cvt.s64.s32 %db, %vb;
    add.s64 %dr, %da, %db;
    setp.eq.u32 %p_sub, %op, 1;
    sub.s64 %dtmp, %da, %db;
    @%p_sub mov.b64 %dr, %dtmp;
    setp.eq.u32 %p_mul, %op, 2;
    mul.lo.s64 %dtmp, %da, %db;
    @%p_mul mov.b64 %dr, %dtmp;
    setp.gt.s64 %p_hi, %dr, 2147483647;
    setp.lt.s64 %p_lo, %dr, -2147483648;
    or.pred %p_ovf, %p_hi, %p_lo;
    @%p_ovf red.global.or.b32 [%ovf], %one;
    cvt.s32.s64 %vr, %dr;
    add.u64 %addr, %out, %o4;
    st.global.s32 [%addr], %vr;
    add.u64 %i, %i, %stride;
    bra loop_bb;
done_bb:
    ret;
}

// out[i] = scalar_on_left ? (s <op> a[i]) : (a[i] <op> s) : buffer combined with an immediate
// literal. The left/right flag preserves non-commutative `sub` (a-s vs s-a). CHECKED int4
// arithmetic: each op is evaluated in 64-bit and range-checked; an int4-overflowing result ORs 1
// into out_overflow_ptr[0] (Postgres `integer out of range`). Stored i32 is wrapped.
.visible .entry gpu_db_buffer_i32_binary_scalar(
    .param .u64 a_ptr,
    .param .s32 scalar,
    .param .u32 op_code,
    .param .u32 scalar_on_left,
    .param .u64 n,
    .param .u64 out_ptr,
    .param .u64 out_overflow_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_sub;
    .reg .pred %p_mul;
    .reg .pred %p_left;
    .reg .pred %p_hi;
    .reg .pred %p_lo;
    .reg .pred %p_ovf;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %op;
    .reg .u32 %onleft;
    .reg .b32 %one;
    .reg .s32 %va;
    .reg .s32 %s;
    .reg .s32 %lhs;
    .reg .s32 %rhs;
    .reg .s32 %vr;
    .reg .s64 %da;
    .reg .s64 %db;
    .reg .s64 %dr;
    .reg .s64 %dtmp;
    .reg .u64 %a;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %ovf;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.s32 %s, [scalar];
    ld.param.u32 %op, [op_code];
    ld.param.u32 %onleft, [scalar_on_left];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_ptr];
    ld.param.u64 %ovf, [out_overflow_ptr];
    mov.b32 %one, 1;
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_bs:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_bs;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %a, %o4;
    ld.global.s32 %va, [%addr];
    setp.ne.u32 %p_left, %onleft, 0;
    mov.b32 %lhs, %va;
    mov.b32 %rhs, %s;
    @%p_left mov.b32 %lhs, %s;
    @%p_left mov.b32 %rhs, %va;
    cvt.s64.s32 %da, %lhs;
    cvt.s64.s32 %db, %rhs;
    add.s64 %dr, %da, %db;
    setp.eq.u32 %p_sub, %op, 1;
    sub.s64 %dtmp, %da, %db;
    @%p_sub mov.b64 %dr, %dtmp;
    setp.eq.u32 %p_mul, %op, 2;
    mul.lo.s64 %dtmp, %da, %db;
    @%p_mul mov.b64 %dr, %dtmp;
    setp.gt.s64 %p_hi, %dr, 2147483647;
    setp.lt.s64 %p_lo, %dr, -2147483648;
    or.pred %p_ovf, %p_hi, %p_lo;
    @%p_ovf red.global.or.b32 [%ovf], %one;
    cvt.s32.s64 %vr, %dr;
    add.u64 %addr, %out, %o4;
    st.global.s32 [%addr], %vr;
    add.u64 %i, %i, %stride;
    bra loop_bs;
done_bs:
    ret;
}

// Compare two int4 intermediate buffers elementwise and atomic-append the matching row indices:
// out_indices[atomicAdd(out_count)] = i  where  a[i] <cmp> b[i]. comparison: 0=eq,1=lt,2=le,3=gt,4=ge.
// Generalizes the comparison RHS from a scalar to an arbitrary expression buffer (col-vs-col /
// expr-vs-expr). Order is atomic-schedule; the host sorts. out_count pre-zeroed by the caller.
.visible .entry gpu_db_buffer_i32_compare_buffers_to_indices(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u64 n,
    .param .u32 comparison,
    .param .u64 out_count_ptr,
    .param .u64 out_indices_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_eq;
    .reg .pred %p_lt;
    .reg .pred %p_le;
    .reg .pred %p_gt;
    .reg .pred %p_ge;
    .reg .pred %c_eq;
    .reg .pred %c_lt;
    .reg .pred %c_le;
    .reg .pred %c_gt;
    .reg .pred %c_ge;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %cmp;
    .reg .u32 %pos;
    .reg .u32 %iu;
    .reg .s32 %va;
    .reg .s32 %vb;
    .reg .u64 %a;
    .reg .u64 %b;
    .reg .u64 %n;
    .reg .u64 %count;
    .reg .u64 %outidx;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.u64 %b, [b_ptr];
    ld.param.u64 %n, [n];
    ld.param.u32 %cmp, [comparison];
    ld.param.u64 %count, [out_count_ptr];
    ld.param.u64 %outidx, [out_indices_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_cb:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_cb;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %a, %o4;
    ld.global.s32 %va, [%addr];
    add.u64 %addr, %b, %o4;
    ld.global.s32 %vb, [%addr];
    setp.eq.s32 %p_eq, %va, %vb;
    setp.lt.s32 %p_lt, %va, %vb;
    setp.le.s32 %p_le, %va, %vb;
    setp.gt.s32 %p_gt, %va, %vb;
    setp.ge.s32 %p_ge, %va, %vb;
    setp.eq.u32 %c_eq, %cmp, 0;
    setp.eq.u32 %c_lt, %cmp, 1;
    setp.eq.u32 %c_le, %cmp, 2;
    setp.eq.u32 %c_gt, %cmp, 3;
    setp.eq.u32 %c_ge, %cmp, 4;
    mov.pred %match, 0;
    and.pred %p_eq, %p_eq, %c_eq;
    or.pred %match, %match, %p_eq;
    and.pred %p_lt, %p_lt, %c_lt;
    or.pred %match, %match, %p_lt;
    and.pred %p_le, %p_le, %c_le;
    or.pred %match, %match, %p_le;
    and.pred %p_gt, %p_gt, %c_gt;
    or.pred %match, %match, %p_gt;
    and.pred %p_ge, %p_ge, %c_ge;
    or.pred %match, %match, %p_ge;
    @!%match bra next_cb;
    atom.global.add.u32 %pos, [%count], 1;
    cvt.u32.u64 %iu, %i;
    mul.lo.u32 %t32, %pos, 4;
    cvt.u64.u32 %addr, %t32;
    add.u64 %addr, %outidx, %addr;
    st.global.u32 [%addr], %iu;
next_cb:
    add.u64 %i, %i, %stride;
    bra loop_cb;
done_cb:
    ret;
}

// ---- Boolean predicate primitives (masks), docs/architecture/17 section 2.3 ----
// A comparison produces a 0/1 MASK buffer; MaskBinary combines masks (AND/OR); the predicate VM
// compacts the final mask to row indices. This lets `p1 AND p2`, `p1 OR p2` lower generally.
// comparison codes: 0=eq,1=lt,2=le,3=gt,4=ge,5=ne.

// out_mask[i] = ( scalar_on_left ? (s <cmp> a[i]) : (a[i] <cmp> s) ) ? 1 : 0.
.visible .entry gpu_db_buffer_i32_compare_scalar_to_mask(
    .param .u64 a_ptr,
    .param .s32 scalar,
    .param .u32 scalar_on_left,
    .param .u32 comparison,
    .param .u64 n,
    .param .u64 out_mask_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_left;
    .reg .pred %p_eq;
    .reg .pred %p_lt;
    .reg .pred %p_le;
    .reg .pred %p_gt;
    .reg .pred %p_ge;
    .reg .pred %p_ne;
    .reg .pred %c_eq;
    .reg .pred %c_lt;
    .reg .pred %c_le;
    .reg .pred %c_gt;
    .reg .pred %c_ge;
    .reg .pred %c_ne;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %cmp;
    .reg .u32 %onleft;
    .reg .s32 %va;
    .reg .s32 %s;
    .reg .s32 %lhs;
    .reg .s32 %rhs;
    .reg .b32 %mask;
    .reg .u64 %a;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.s32 %s, [scalar];
    ld.param.u32 %onleft, [scalar_on_left];
    ld.param.u32 %cmp, [comparison];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_mask_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_csm:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_csm;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %a, %o4;
    ld.global.s32 %va, [%addr];
    setp.ne.u32 %p_left, %onleft, 0;
    mov.b32 %lhs, %va;
    mov.b32 %rhs, %s;
    @%p_left mov.b32 %lhs, %s;
    @%p_left mov.b32 %rhs, %va;
    setp.eq.s32 %p_eq, %lhs, %rhs;
    setp.lt.s32 %p_lt, %lhs, %rhs;
    setp.le.s32 %p_le, %lhs, %rhs;
    setp.gt.s32 %p_gt, %lhs, %rhs;
    setp.ge.s32 %p_ge, %lhs, %rhs;
    setp.ne.s32 %p_ne, %lhs, %rhs;
    setp.eq.u32 %c_eq, %cmp, 0;
    setp.eq.u32 %c_lt, %cmp, 1;
    setp.eq.u32 %c_le, %cmp, 2;
    setp.eq.u32 %c_gt, %cmp, 3;
    setp.eq.u32 %c_ge, %cmp, 4;
    setp.eq.u32 %c_ne, %cmp, 5;
    mov.pred %match, 0;
    and.pred %p_eq, %p_eq, %c_eq;
    or.pred %match, %match, %p_eq;
    and.pred %p_lt, %p_lt, %c_lt;
    or.pred %match, %match, %p_lt;
    and.pred %p_le, %p_le, %c_le;
    or.pred %match, %match, %p_le;
    and.pred %p_gt, %p_gt, %c_gt;
    or.pred %match, %match, %p_gt;
    and.pred %p_ge, %p_ge, %c_ge;
    or.pred %match, %match, %p_ge;
    and.pred %p_ne, %p_ne, %c_ne;
    or.pred %match, %match, %p_ne;
    selp.b32 %mask, 1, 0, %match;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %mask;
    add.u64 %i, %i, %stride;
    bra loop_csm;
done_csm:
    ret;
}

// out_mask[i] = (a[i] <cmp> b[i]) ? 1 : 0  over two value buffers.
.visible .entry gpu_db_buffer_i32_compare_buffers_to_mask(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u32 comparison,
    .param .u64 n,
    .param .u64 out_mask_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_eq;
    .reg .pred %p_lt;
    .reg .pred %p_le;
    .reg .pred %p_gt;
    .reg .pred %p_ge;
    .reg .pred %p_ne;
    .reg .pred %c_eq;
    .reg .pred %c_lt;
    .reg .pred %c_le;
    .reg .pred %c_gt;
    .reg .pred %c_ge;
    .reg .pred %c_ne;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %cmp;
    .reg .s32 %va;
    .reg .s32 %vb;
    .reg .b32 %mask;
    .reg .u64 %a;
    .reg .u64 %b;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.u64 %b, [b_ptr];
    ld.param.u32 %cmp, [comparison];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_mask_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_cbm:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_cbm;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %a, %o4;
    ld.global.s32 %va, [%addr];
    add.u64 %addr, %b, %o4;
    ld.global.s32 %vb, [%addr];
    setp.eq.s32 %p_eq, %va, %vb;
    setp.lt.s32 %p_lt, %va, %vb;
    setp.le.s32 %p_le, %va, %vb;
    setp.gt.s32 %p_gt, %va, %vb;
    setp.ge.s32 %p_ge, %va, %vb;
    setp.ne.s32 %p_ne, %va, %vb;
    setp.eq.u32 %c_eq, %cmp, 0;
    setp.eq.u32 %c_lt, %cmp, 1;
    setp.eq.u32 %c_le, %cmp, 2;
    setp.eq.u32 %c_gt, %cmp, 3;
    setp.eq.u32 %c_ge, %cmp, 4;
    setp.eq.u32 %c_ne, %cmp, 5;
    mov.pred %match, 0;
    and.pred %p_eq, %p_eq, %c_eq;
    or.pred %match, %match, %p_eq;
    and.pred %p_lt, %p_lt, %c_lt;
    or.pred %match, %match, %p_lt;
    and.pred %p_le, %p_le, %c_le;
    or.pred %match, %match, %p_le;
    and.pred %p_gt, %p_gt, %c_gt;
    or.pred %match, %match, %p_gt;
    and.pred %p_ge, %p_ge, %c_ge;
    or.pred %match, %match, %p_ge;
    and.pred %p_ne, %p_ne, %c_ne;
    or.pred %match, %match, %p_ne;
    selp.b32 %mask, 1, 0, %match;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %mask;
    add.u64 %i, %i, %stride;
    bra loop_cbm;
done_cbm:
    ret;
}

// out[i] = op==0 ? (a[i] && b[i]) : (a[i] || b[i])  over two 0/1 masks.
.visible .entry gpu_db_mask_binary(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u32 op_code,
    .param .u64 n,
    .param .u64 out_ptr
)
{
    .reg .pred %p;
    .reg .pred %pa;
    .reg .pred %pb;
    .reg .pred %pand;
    .reg .pred %por;
    .reg .pred %p_isor;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %op;
    .reg .s32 %va;
    .reg .s32 %vb;
    .reg .b32 %vand;
    .reg .b32 %vor;
    .reg .b32 %mask;
    .reg .u64 %a;
    .reg .u64 %b;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.u64 %b, [b_ptr];
    ld.param.u32 %op, [op_code];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_mb:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_mb;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %a, %o4;
    ld.global.s32 %va, [%addr];
    add.u64 %addr, %b, %o4;
    ld.global.s32 %vb, [%addr];
    setp.ne.s32 %pa, %va, 0;
    setp.ne.s32 %pb, %vb, 0;
    and.pred %pand, %pa, %pb;
    or.pred %por, %pa, %pb;
    selp.b32 %vand, 1, 0, %pand;
    selp.b32 %vor, 1, 0, %por;
    setp.eq.u32 %p_isor, %op, 1;
    selp.b32 %mask, %vor, %vand, %p_isor;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %mask;
    add.u64 %i, %i, %stride;
    bra loop_mb;
done_mb:
    ret;
}

// Compact a 0/1 mask buffer to matching row indices via an atomic counter (atomic-schedule order;
// host sorts). out_count pre-zeroed by the caller; out_indices capacity n*4.
.visible .entry gpu_db_mask_compact_to_indices(
    .param .u64 mask_ptr,
    .param .u64 n,
    .param .u64 out_count_ptr,
    .param .u64 out_indices_ptr
)
{
    .reg .pred %p;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %pos;
    .reg .u32 %iu;
    .reg .s32 %v;
    .reg .u64 %mask;
    .reg .u64 %n;
    .reg .u64 %count;
    .reg .u64 %outidx;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %mask, [mask_ptr];
    ld.param.u64 %n, [n];
    ld.param.u64 %count, [out_count_ptr];
    ld.param.u64 %outidx, [out_indices_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_mc:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_mc;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %mask, %o4;
    ld.global.s32 %v, [%addr];
    setp.ne.s32 %match, %v, 0;
    @!%match bra next_mc;
    atom.global.add.u32 %pos, [%count], 1;
    cvt.u32.u64 %iu, %i;
    mul.lo.u32 %t32, %pos, 4;
    cvt.u64.u32 %addr, %t32;
    add.u64 %addr, %outidx, %addr;
    st.global.u32 [%addr], %iu;
next_mc:
    add.u64 %i, %i, %stride;
    bra loop_mc;
done_mc:
    ret;
}

// ---- int8 (s64) comparison primitives (the type matrix, docs/architecture/19) ----
// Read a resident int8 column DIRECTLY (no intermediate buffer) and emit an i32 0/1 MASK, compacted
// to row indices by the type-agnostic gpu_db_mask_compact_to_indices. The int8 value stride is 8
// bytes; the mask stride is 4. comparison: 0=eq,1=lt,2=le,3=gt,4=ge,5=ne. (int8 ARITHMETIC needs i64
// value buffers + the type-aware arith VM, a later slice; simple comparison does not.)

// out_mask[i] = ( scalar_on_left ? (s <cmp> col[i]) : (col[i] <cmp> s) ) ? 1 : 0  over a resident int8
// column at resident_ptr + byte_offset.
.visible .entry gpu_db_resident_i64_compare_scalar_to_mask(
    .param .u64 resident_ptr,
    .param .u64 byte_offset,
    .param .s64 scalar,
    .param .u32 scalar_on_left,
    .param .u32 comparison,
    .param .u64 n,
    .param .u64 out_mask_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_left;
    .reg .pred %p_eq;
    .reg .pred %p_lt;
    .reg .pred %p_le;
    .reg .pred %p_gt;
    .reg .pred %p_ge;
    .reg .pred %p_ne;
    .reg .pred %c_eq;
    .reg .pred %c_lt;
    .reg .pred %c_le;
    .reg .pred %c_gt;
    .reg .pred %c_ge;
    .reg .pred %c_ne;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %cmp;
    .reg .u32 %onleft;
    .reg .s64 %va;
    .reg .s64 %s;
    .reg .s64 %lhs;
    .reg .s64 %rhs;
    .reg .b32 %mask;
    .reg .b32 %w0;
    .reg .b32 %w1;
    .reg .u64 %base;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o8;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %base, [resident_ptr];
    ld.param.u64 %addr, [byte_offset];
    add.u64 %base, %base, %addr;
    ld.param.s64 %s, [scalar];
    ld.param.u32 %onleft, [scalar_on_left];
    ld.param.u32 %cmp, [comparison];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_mask_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_csm64:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_csm64;
    mul.lo.u64 %o8, %i, 8;
    add.u64 %addr, %base, %o8;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    mov.b64 %va, {%w0, %w1};
    setp.ne.u32 %p_left, %onleft, 0;
    mov.b64 %lhs, %va;
    mov.b64 %rhs, %s;
    @%p_left mov.b64 %lhs, %s;
    @%p_left mov.b64 %rhs, %va;
    setp.eq.s64 %p_eq, %lhs, %rhs;
    setp.lt.s64 %p_lt, %lhs, %rhs;
    setp.le.s64 %p_le, %lhs, %rhs;
    setp.gt.s64 %p_gt, %lhs, %rhs;
    setp.ge.s64 %p_ge, %lhs, %rhs;
    setp.ne.s64 %p_ne, %lhs, %rhs;
    setp.eq.u32 %c_eq, %cmp, 0;
    setp.eq.u32 %c_lt, %cmp, 1;
    setp.eq.u32 %c_le, %cmp, 2;
    setp.eq.u32 %c_gt, %cmp, 3;
    setp.eq.u32 %c_ge, %cmp, 4;
    setp.eq.u32 %c_ne, %cmp, 5;
    mov.pred %match, 0;
    and.pred %p_eq, %p_eq, %c_eq;
    or.pred %match, %match, %p_eq;
    and.pred %p_lt, %p_lt, %c_lt;
    or.pred %match, %match, %p_lt;
    and.pred %p_le, %p_le, %c_le;
    or.pred %match, %match, %p_le;
    and.pred %p_gt, %p_gt, %c_gt;
    or.pred %match, %match, %p_gt;
    and.pred %p_ge, %p_ge, %c_ge;
    or.pred %match, %match, %p_ge;
    and.pred %p_ne, %p_ne, %c_ne;
    or.pred %match, %match, %p_ne;
    selp.b32 %mask, 1, 0, %match;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %mask;
    add.u64 %i, %i, %stride;
    bra loop_csm64;
done_csm64:
    ret;
}

// out_mask[i] = (a[i] <cmp> b[i]) ? 1 : 0  over two resident int8 columns at resident_ptr +
// a_byte_offset / + b_byte_offset.
.visible .entry gpu_db_resident_i64_compare_columns_to_mask(
    .param .u64 resident_ptr,
    .param .u64 a_byte_offset,
    .param .u64 b_byte_offset,
    .param .u32 comparison,
    .param .u64 n,
    .param .u64 out_mask_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_eq;
    .reg .pred %p_lt;
    .reg .pred %p_le;
    .reg .pred %p_gt;
    .reg .pred %p_ge;
    .reg .pred %p_ne;
    .reg .pred %c_eq;
    .reg .pred %c_lt;
    .reg .pred %c_le;
    .reg .pred %c_gt;
    .reg .pred %c_ge;
    .reg .pred %c_ne;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %cmp;
    .reg .s64 %va;
    .reg .s64 %vb;
    .reg .b32 %mask;
    .reg .u64 %res;
    .reg .u64 %abase;
    .reg .u64 %bbase;
    .reg .b32 %w0;
    .reg .b32 %w1;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o8;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %res, [resident_ptr];
    ld.param.u64 %abase, [a_byte_offset];
    ld.param.u64 %bbase, [b_byte_offset];
    add.u64 %abase, %res, %abase;
    add.u64 %bbase, %res, %bbase;
    ld.param.u32 %cmp, [comparison];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_mask_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_ccm64:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_ccm64;
    mul.lo.u64 %o8, %i, 8;
    add.u64 %addr, %abase, %o8;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    mov.b64 %va, {%w0, %w1};
    add.u64 %addr, %bbase, %o8;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    mov.b64 %vb, {%w0, %w1};
    setp.eq.s64 %p_eq, %va, %vb;
    setp.lt.s64 %p_lt, %va, %vb;
    setp.le.s64 %p_le, %va, %vb;
    setp.gt.s64 %p_gt, %va, %vb;
    setp.ge.s64 %p_ge, %va, %vb;
    setp.ne.s64 %p_ne, %va, %vb;
    setp.eq.u32 %c_eq, %cmp, 0;
    setp.eq.u32 %c_lt, %cmp, 1;
    setp.eq.u32 %c_le, %cmp, 2;
    setp.eq.u32 %c_gt, %cmp, 3;
    setp.eq.u32 %c_ge, %cmp, 4;
    setp.eq.u32 %c_ne, %cmp, 5;
    mov.pred %match, 0;
    and.pred %p_eq, %p_eq, %c_eq;
    or.pred %match, %match, %p_eq;
    and.pred %p_lt, %p_lt, %c_lt;
    or.pred %match, %match, %p_lt;
    and.pred %p_le, %p_le, %c_le;
    or.pred %match, %match, %p_le;
    and.pred %p_gt, %p_gt, %c_gt;
    or.pred %match, %match, %p_gt;
    and.pred %p_ge, %p_ge, %c_ge;
    or.pred %match, %match, %p_ge;
    and.pred %p_ne, %p_ne, %c_ne;
    or.pred %match, %match, %p_ne;
    selp.b32 %mask, 1, 0, %match;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %mask;
    add.u64 %i, %i, %stride;
    bra loop_ccm64;
done_ccm64:
    ret;
}

// ---- int8 (s64) BUFFER VM primitives for the type-aware arith VM (the type matrix, doc 19) ----
// The i64 analogs of the i32 buffer VM kernels: an arbitrary int8 arithmetic tree lowers to a postfix
// program over leased i64 INTERMEDIATE buffers (8 bytes/element), then a terminal compare->mask.
// CHECKED int8 arithmetic raises Postgres `integer out of range` on int64 overflow via the shared
// overflow flag (add/sub: sign-XOR; mul: mul.hi vs the sign-extension of mul.lo). op 0=add/1=sub/2=mul.

// out[i] = column[i] : load a resident int8 column (resident_ptr + byte_offset) into an i64 buffer.
.visible .entry gpu_db_resident_i64_load_column(
    .param .u64 resident_ptr,
    .param .u64 byte_offset,
    .param .u64 n,
    .param .u64 out_ptr
)
{
    .reg .pred %p;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .s64 %v;
    .reg .b32 %w0;
    .reg .b32 %w1;
    .reg .u64 %src;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o8;
    .reg .u64 %addr;

    ld.param.u64 %src, [resident_ptr];
    ld.param.u64 %addr, [byte_offset];
    add.u64 %src, %src, %addr;
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_ld64:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_ld64;
    mul.lo.u64 %o8, %i, 8;
    add.u64 %addr, %src, %o8;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    mov.b64 %v, {%w0, %w1};
    add.u64 %addr, %out, %o8;
    st.global.s64 [%addr], %v;
    add.u64 %i, %i, %stride;
    bra loop_ld64;
done_ld64:
    ret;
}

// out[i] = a[i] <op> b[i] : checked int8 arithmetic over two i64 buffers (absolute ptrs).
.visible .entry gpu_db_buffer_i64_binary(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u32 op_code,
    .param .u64 n,
    .param .u64 out_ptr,
    .param .u64 out_overflow_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_sub;
    .reg .pred %p_mul;
    .reg .pred %c1;
    .reg .pred %c2;
    .reg .pred %pp;
    .reg .pred %p_ovf;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %op;
    .reg .u32 %one;
    .reg .u32 %o_add;
    .reg .u32 %o_sub;
    .reg .u32 %o_mul;
    .reg .u32 %ovf_val;
    .reg .s64 %va;
    .reg .s64 %vb;
    .reg .s64 %r;
    .reg .s64 %r_sub;
    .reg .s64 %r_mul;
    .reg .s64 %hi;
    .reg .s64 %sign;
    .reg .s64 %t;
    .reg .u64 %a;
    .reg .u64 %b;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %ovf;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o8;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.u64 %b, [b_ptr];
    ld.param.u32 %op, [op_code];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_ptr];
    ld.param.u64 %ovf, [out_overflow_ptr];
    mov.u32 %one, 1;
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_bb64:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_bb64;
    mul.lo.u64 %o8, %i, 8;
    add.u64 %addr, %a, %o8;
    ld.global.s64 %va, [%addr];
    add.u64 %addr, %b, %o8;
    ld.global.s64 %vb, [%addr];
    add.s64 %r, %va, %vb;
    xor.b64 %t, %va, %vb;
    setp.ge.s64 %c1, %t, 0;
    xor.b64 %t, %va, %r;
    setp.lt.s64 %c2, %t, 0;
    and.pred %pp, %c1, %c2;
    selp.u32 %o_add, 1, 0, %pp;
    mov.u32 %ovf_val, %o_add;
    sub.s64 %r_sub, %va, %vb;
    xor.b64 %t, %va, %vb;
    setp.lt.s64 %c1, %t, 0;
    xor.b64 %t, %va, %r_sub;
    setp.lt.s64 %c2, %t, 0;
    and.pred %pp, %c1, %c2;
    selp.u32 %o_sub, 1, 0, %pp;
    setp.eq.u32 %p_sub, %op, 1;
    @%p_sub mov.b64 %r, %r_sub;
    @%p_sub mov.u32 %ovf_val, %o_sub;
    mul.lo.s64 %r_mul, %va, %vb;
    mul.hi.s64 %hi, %va, %vb;
    shr.s64 %sign, %r_mul, 63;
    setp.ne.s64 %pp, %hi, %sign;
    selp.u32 %o_mul, 1, 0, %pp;
    setp.eq.u32 %p_mul, %op, 2;
    @%p_mul mov.b64 %r, %r_mul;
    @%p_mul mov.u32 %ovf_val, %o_mul;
    setp.ne.u32 %p_ovf, %ovf_val, 0;
    @%p_ovf red.global.or.b32 [%ovf], %one;
    add.u64 %addr, %out, %o8;
    st.global.s64 [%addr], %r;
    add.u64 %i, %i, %stride;
    bra loop_bb64;
done_bb64:
    ret;
}

// out[i] = scalar_on_left ? (s <op> a[i]) : (a[i] <op> s) : checked int8 arithmetic, buffer + scalar.
.visible .entry gpu_db_buffer_i64_binary_scalar(
    .param .u64 a_ptr,
    .param .s64 scalar,
    .param .u32 op_code,
    .param .u32 scalar_on_left,
    .param .u64 n,
    .param .u64 out_ptr,
    .param .u64 out_overflow_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_sub;
    .reg .pred %p_mul;
    .reg .pred %p_left;
    .reg .pred %c1;
    .reg .pred %c2;
    .reg .pred %pp;
    .reg .pred %p_ovf;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %op;
    .reg .u32 %onleft;
    .reg .u32 %one;
    .reg .u32 %o_add;
    .reg .u32 %o_sub;
    .reg .u32 %o_mul;
    .reg .u32 %ovf_val;
    .reg .s64 %va;
    .reg .s64 %s;
    .reg .s64 %lhs;
    .reg .s64 %rhs;
    .reg .s64 %r;
    .reg .s64 %r_sub;
    .reg .s64 %r_mul;
    .reg .s64 %hi;
    .reg .s64 %sign;
    .reg .s64 %t;
    .reg .u64 %a;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %ovf;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o8;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.s64 %s, [scalar];
    ld.param.u32 %op, [op_code];
    ld.param.u32 %onleft, [scalar_on_left];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_ptr];
    ld.param.u64 %ovf, [out_overflow_ptr];
    mov.u32 %one, 1;
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_bs64:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_bs64;
    mul.lo.u64 %o8, %i, 8;
    add.u64 %addr, %a, %o8;
    ld.global.s64 %va, [%addr];
    setp.ne.u32 %p_left, %onleft, 0;
    mov.b64 %lhs, %va;
    mov.b64 %rhs, %s;
    @%p_left mov.b64 %lhs, %s;
    @%p_left mov.b64 %rhs, %va;
    add.s64 %r, %lhs, %rhs;
    xor.b64 %t, %lhs, %rhs;
    setp.ge.s64 %c1, %t, 0;
    xor.b64 %t, %lhs, %r;
    setp.lt.s64 %c2, %t, 0;
    and.pred %pp, %c1, %c2;
    selp.u32 %o_add, 1, 0, %pp;
    mov.u32 %ovf_val, %o_add;
    sub.s64 %r_sub, %lhs, %rhs;
    xor.b64 %t, %lhs, %rhs;
    setp.lt.s64 %c1, %t, 0;
    xor.b64 %t, %lhs, %r_sub;
    setp.lt.s64 %c2, %t, 0;
    and.pred %pp, %c1, %c2;
    selp.u32 %o_sub, 1, 0, %pp;
    setp.eq.u32 %p_sub, %op, 1;
    @%p_sub mov.b64 %r, %r_sub;
    @%p_sub mov.u32 %ovf_val, %o_sub;
    mul.lo.s64 %r_mul, %lhs, %rhs;
    mul.hi.s64 %hi, %lhs, %rhs;
    shr.s64 %sign, %r_mul, 63;
    setp.ne.s64 %pp, %hi, %sign;
    selp.u32 %o_mul, 1, 0, %pp;
    setp.eq.u32 %p_mul, %op, 2;
    @%p_mul mov.b64 %r, %r_mul;
    @%p_mul mov.u32 %ovf_val, %o_mul;
    setp.ne.u32 %p_ovf, %ovf_val, 0;
    @%p_ovf red.global.or.b32 [%ovf], %one;
    add.u64 %addr, %out, %o8;
    st.global.s64 [%addr], %r;
    add.u64 %i, %i, %stride;
    bra loop_bs64;
done_bs64:
    ret;
}

// out_mask[i] = ( scalar_on_left ? (s <cmp> a[i]) : (a[i] <cmp> s) ) ? 1 : 0  over an i64 buffer.
.visible .entry gpu_db_buffer_i64_compare_scalar_to_mask(
    .param .u64 a_ptr,
    .param .s64 scalar,
    .param .u32 scalar_on_left,
    .param .u32 comparison,
    .param .u64 n,
    .param .u64 out_mask_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_left;
    .reg .pred %p_eq;
    .reg .pred %p_lt;
    .reg .pred %p_le;
    .reg .pred %p_gt;
    .reg .pred %p_ge;
    .reg .pred %p_ne;
    .reg .pred %c_eq;
    .reg .pred %c_lt;
    .reg .pred %c_le;
    .reg .pred %c_gt;
    .reg .pred %c_ge;
    .reg .pred %c_ne;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %cmp;
    .reg .u32 %onleft;
    .reg .s64 %va;
    .reg .s64 %s;
    .reg .s64 %lhs;
    .reg .s64 %rhs;
    .reg .b32 %mask;
    .reg .u64 %a;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o8;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.s64 %s, [scalar];
    ld.param.u32 %onleft, [scalar_on_left];
    ld.param.u32 %cmp, [comparison];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_mask_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_bcs64:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_bcs64;
    mul.lo.u64 %o8, %i, 8;
    add.u64 %addr, %a, %o8;
    ld.global.s64 %va, [%addr];
    setp.ne.u32 %p_left, %onleft, 0;
    mov.b64 %lhs, %va;
    mov.b64 %rhs, %s;
    @%p_left mov.b64 %lhs, %s;
    @%p_left mov.b64 %rhs, %va;
    setp.eq.s64 %p_eq, %lhs, %rhs;
    setp.lt.s64 %p_lt, %lhs, %rhs;
    setp.le.s64 %p_le, %lhs, %rhs;
    setp.gt.s64 %p_gt, %lhs, %rhs;
    setp.ge.s64 %p_ge, %lhs, %rhs;
    setp.ne.s64 %p_ne, %lhs, %rhs;
    setp.eq.u32 %c_eq, %cmp, 0;
    setp.eq.u32 %c_lt, %cmp, 1;
    setp.eq.u32 %c_le, %cmp, 2;
    setp.eq.u32 %c_gt, %cmp, 3;
    setp.eq.u32 %c_ge, %cmp, 4;
    setp.eq.u32 %c_ne, %cmp, 5;
    mov.pred %match, 0;
    and.pred %p_eq, %p_eq, %c_eq;
    or.pred %match, %match, %p_eq;
    and.pred %p_lt, %p_lt, %c_lt;
    or.pred %match, %match, %p_lt;
    and.pred %p_le, %p_le, %c_le;
    or.pred %match, %match, %p_le;
    and.pred %p_gt, %p_gt, %c_gt;
    or.pred %match, %match, %p_gt;
    and.pred %p_ge, %p_ge, %c_ge;
    or.pred %match, %match, %p_ge;
    and.pred %p_ne, %p_ne, %c_ne;
    or.pred %match, %match, %p_ne;
    selp.b32 %mask, 1, 0, %match;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %mask;
    add.u64 %i, %i, %stride;
    bra loop_bcs64;
done_bcs64:
    ret;
}

// out_mask[i] = (a[i] <cmp> b[i]) ? 1 : 0  over two i64 buffers (absolute ptrs).
.visible .entry gpu_db_buffer_i64_compare_buffers_to_mask(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u32 comparison,
    .param .u64 n,
    .param .u64 out_mask_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_eq;
    .reg .pred %p_lt;
    .reg .pred %p_le;
    .reg .pred %p_gt;
    .reg .pred %p_ge;
    .reg .pred %p_ne;
    .reg .pred %c_eq;
    .reg .pred %c_lt;
    .reg .pred %c_le;
    .reg .pred %c_gt;
    .reg .pred %c_ge;
    .reg .pred %c_ne;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %cmp;
    .reg .s64 %va;
    .reg .s64 %vb;
    .reg .b32 %mask;
    .reg .u64 %a;
    .reg .u64 %b;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o8;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.u64 %b, [b_ptr];
    ld.param.u32 %cmp, [comparison];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_mask_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_bcb64:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_bcb64;
    mul.lo.u64 %o8, %i, 8;
    add.u64 %addr, %a, %o8;
    ld.global.s64 %va, [%addr];
    add.u64 %addr, %b, %o8;
    ld.global.s64 %vb, [%addr];
    setp.eq.s64 %p_eq, %va, %vb;
    setp.lt.s64 %p_lt, %va, %vb;
    setp.le.s64 %p_le, %va, %vb;
    setp.gt.s64 %p_gt, %va, %vb;
    setp.ge.s64 %p_ge, %va, %vb;
    setp.ne.s64 %p_ne, %va, %vb;
    setp.eq.u32 %c_eq, %cmp, 0;
    setp.eq.u32 %c_lt, %cmp, 1;
    setp.eq.u32 %c_le, %cmp, 2;
    setp.eq.u32 %c_gt, %cmp, 3;
    setp.eq.u32 %c_ge, %cmp, 4;
    setp.eq.u32 %c_ne, %cmp, 5;
    mov.pred %match, 0;
    and.pred %p_eq, %p_eq, %c_eq;
    or.pred %match, %match, %p_eq;
    and.pred %p_lt, %p_lt, %c_lt;
    or.pred %match, %match, %p_lt;
    and.pred %p_le, %p_le, %c_le;
    or.pred %match, %match, %p_le;
    and.pred %p_gt, %p_gt, %c_gt;
    or.pred %match, %match, %p_gt;
    and.pred %p_ge, %p_ge, %c_ge;
    or.pred %match, %match, %p_ge;
    and.pred %p_ne, %p_ne, %c_ne;
    or.pred %match, %match, %p_ne;
    selp.b32 %mask, 1, 0, %match;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %mask;
    add.u64 %i, %i, %stride;
    bra loop_bcb64;
done_bcb64:
    ret;
}

// ---- numeric (i128) compare primitives (the type matrix, doc 19) ----
// A numeric column is a 16-byte signed i128 mantissa per row (low u64 @ +0, high s64 @ +8),
// little-endian, at the column's catalog scale. Signed 128-bit compare: compare the high limbs as
// s64; on a tie, the low limbs as u64. Comparison codes 0=eq 1=lt 2=le 3=gt 4=ge 5=ne. The decimal
// scale is reconciled on the host (the literal is rescaled to the column scale before launch), so the
// kernel is a pure mantissa compare.

// out_mask[i] = ( scalar_on_left ? (s <cmp> col[i]) : (col[i] <cmp> s) ) ? 1 : 0  over an i128 column.
.visible .entry gpu_db_resident_i128_compare_scalar_to_mask(
    .param .u64 resident_ptr,
    .param .u64 byte_offset,
    .param .u64 scalar_lo,
    .param .u64 scalar_hi,
    .param .u32 scalar_on_left,
    .param .u32 comparison,
    .param .u64 n,
    .param .u64 out_mask_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_left;
    .reg .pred %hi_eq;
    .reg .pred %hi_lt;
    .reg .pred %hi_gt;
    .reg .pred %lo_eq;
    .reg .pred %lo_lt;
    .reg .pred %lo_gt;
    .reg .pred %p_eq;
    .reg .pred %p_lt;
    .reg .pred %p_le;
    .reg .pred %p_gt;
    .reg .pred %p_ge;
    .reg .pred %p_ne;
    .reg .pred %tmp;
    .reg .pred %c_eq;
    .reg .pred %c_lt;
    .reg .pred %c_le;
    .reg .pred %c_gt;
    .reg .pred %c_ge;
    .reg .pred %c_ne;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %cmp;
    .reg .u32 %onleft;
    .reg .b64 %s_lo;
    .reg .b64 %s_hi;
    .reg .b64 %col_lo;
    .reg .b64 %col_hi;
    .reg .b64 %lhs_lo;
    .reg .b64 %lhs_hi;
    .reg .b64 %rhs_lo;
    .reg .b64 %rhs_hi;
    .reg .b32 %mask;
    .reg .b32 %w0;
    .reg .b32 %w1;
    .reg .u64 %src;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o16;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %src, [resident_ptr];
    ld.param.u64 %addr, [byte_offset];
    add.u64 %src, %src, %addr;
    ld.param.u64 %s_lo, [scalar_lo];
    ld.param.u64 %s_hi, [scalar_hi];
    ld.param.u32 %onleft, [scalar_on_left];
    ld.param.u32 %cmp, [comparison];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_mask_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_ncs:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_ncs;
    mul.lo.u64 %o16, %i, 16;
    add.u64 %addr, %src, %o16;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    mov.b64 %col_lo, {%w0, %w1};
    ld.global.u32 %w0, [%addr+8];
    ld.global.u32 %w1, [%addr+12];
    mov.b64 %col_hi, {%w0, %w1};
    setp.ne.u32 %p_left, %onleft, 0;
    mov.b64 %lhs_lo, %col_lo;
    mov.b64 %lhs_hi, %col_hi;
    mov.b64 %rhs_lo, %s_lo;
    mov.b64 %rhs_hi, %s_hi;
    @%p_left mov.b64 %lhs_lo, %s_lo;
    @%p_left mov.b64 %lhs_hi, %s_hi;
    @%p_left mov.b64 %rhs_lo, %col_lo;
    @%p_left mov.b64 %rhs_hi, %col_hi;
    setp.eq.s64 %hi_eq, %lhs_hi, %rhs_hi;
    setp.lt.s64 %hi_lt, %lhs_hi, %rhs_hi;
    setp.gt.s64 %hi_gt, %lhs_hi, %rhs_hi;
    setp.eq.u64 %lo_eq, %lhs_lo, %rhs_lo;
    setp.lt.u64 %lo_lt, %lhs_lo, %rhs_lo;
    setp.gt.u64 %lo_gt, %lhs_lo, %rhs_lo;
    and.pred %p_eq, %hi_eq, %lo_eq;
    and.pred %tmp, %hi_eq, %lo_lt;
    or.pred %p_lt, %hi_lt, %tmp;
    and.pred %tmp, %hi_eq, %lo_gt;
    or.pred %p_gt, %hi_gt, %tmp;
    not.pred %p_le, %p_gt;
    not.pred %p_ge, %p_lt;
    not.pred %p_ne, %p_eq;
    setp.eq.u32 %c_eq, %cmp, 0;
    setp.eq.u32 %c_lt, %cmp, 1;
    setp.eq.u32 %c_le, %cmp, 2;
    setp.eq.u32 %c_gt, %cmp, 3;
    setp.eq.u32 %c_ge, %cmp, 4;
    setp.eq.u32 %c_ne, %cmp, 5;
    mov.pred %match, 0;
    and.pred %p_eq, %p_eq, %c_eq;
    or.pred %match, %match, %p_eq;
    and.pred %p_lt, %p_lt, %c_lt;
    or.pred %match, %match, %p_lt;
    and.pred %p_le, %p_le, %c_le;
    or.pred %match, %match, %p_le;
    and.pred %p_gt, %p_gt, %c_gt;
    or.pred %match, %match, %p_gt;
    and.pred %p_ge, %p_ge, %c_ge;
    or.pred %match, %match, %p_ge;
    and.pred %p_ne, %p_ne, %c_ne;
    or.pred %match, %match, %p_ne;
    selp.b32 %mask, 1, 0, %match;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %mask;
    add.u64 %i, %i, %stride;
    bra loop_ncs;
done_ncs:
    ret;
}

// out_mask[i] = (a[i] <cmp> b[i]) ? 1 : 0  over two i128 columns (each at resident_ptr + its offset).
.visible .entry gpu_db_resident_i128_compare_columns_to_mask(
    .param .u64 resident_ptr,
    .param .u64 a_byte_offset,
    .param .u64 b_byte_offset,
    .param .u32 comparison,
    .param .u64 n,
    .param .u64 out_mask_ptr
)
{
    .reg .pred %p;
    .reg .pred %hi_eq;
    .reg .pred %hi_lt;
    .reg .pred %hi_gt;
    .reg .pred %lo_eq;
    .reg .pred %lo_lt;
    .reg .pred %lo_gt;
    .reg .pred %p_eq;
    .reg .pred %p_lt;
    .reg .pred %p_le;
    .reg .pred %p_gt;
    .reg .pred %p_ge;
    .reg .pred %p_ne;
    .reg .pred %tmp;
    .reg .pred %c_eq;
    .reg .pred %c_lt;
    .reg .pred %c_le;
    .reg .pred %c_gt;
    .reg .pred %c_ge;
    .reg .pred %c_ne;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %cmp;
    .reg .b64 %a_lo;
    .reg .b64 %a_hi;
    .reg .b64 %b_lo;
    .reg .b64 %b_hi;
    .reg .b32 %mask;
    .reg .b32 %w0;
    .reg .b32 %w1;
    .reg .u64 %a_src;
    .reg .u64 %b_src;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o16;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %a_src, [resident_ptr];
    ld.param.u64 %b_src, [resident_ptr];
    ld.param.u64 %addr, [a_byte_offset];
    add.u64 %a_src, %a_src, %addr;
    ld.param.u64 %addr, [b_byte_offset];
    add.u64 %b_src, %b_src, %addr;
    ld.param.u32 %cmp, [comparison];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_mask_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_ncc:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_ncc;
    mul.lo.u64 %o16, %i, 16;
    add.u64 %addr, %a_src, %o16;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    mov.b64 %a_lo, {%w0, %w1};
    ld.global.u32 %w0, [%addr+8];
    ld.global.u32 %w1, [%addr+12];
    mov.b64 %a_hi, {%w0, %w1};
    add.u64 %addr, %b_src, %o16;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    mov.b64 %b_lo, {%w0, %w1};
    ld.global.u32 %w0, [%addr+8];
    ld.global.u32 %w1, [%addr+12];
    mov.b64 %b_hi, {%w0, %w1};
    setp.eq.s64 %hi_eq, %a_hi, %b_hi;
    setp.lt.s64 %hi_lt, %a_hi, %b_hi;
    setp.gt.s64 %hi_gt, %a_hi, %b_hi;
    setp.eq.u64 %lo_eq, %a_lo, %b_lo;
    setp.lt.u64 %lo_lt, %a_lo, %b_lo;
    setp.gt.u64 %lo_gt, %a_lo, %b_lo;
    and.pred %p_eq, %hi_eq, %lo_eq;
    and.pred %tmp, %hi_eq, %lo_lt;
    or.pred %p_lt, %hi_lt, %tmp;
    and.pred %tmp, %hi_eq, %lo_gt;
    or.pred %p_gt, %hi_gt, %tmp;
    not.pred %p_le, %p_gt;
    not.pred %p_ge, %p_lt;
    not.pred %p_ne, %p_eq;
    setp.eq.u32 %c_eq, %cmp, 0;
    setp.eq.u32 %c_lt, %cmp, 1;
    setp.eq.u32 %c_le, %cmp, 2;
    setp.eq.u32 %c_gt, %cmp, 3;
    setp.eq.u32 %c_ge, %cmp, 4;
    setp.eq.u32 %c_ne, %cmp, 5;
    mov.pred %match, 0;
    and.pred %p_eq, %p_eq, %c_eq;
    or.pred %match, %match, %p_eq;
    and.pred %p_lt, %p_lt, %c_lt;
    or.pred %match, %match, %p_lt;
    and.pred %p_le, %p_le, %c_le;
    or.pred %match, %match, %p_le;
    and.pred %p_gt, %p_gt, %c_gt;
    or.pred %match, %match, %p_gt;
    and.pred %p_ge, %p_ge, %c_ge;
    or.pred %match, %match, %p_ge;
    and.pred %p_ne, %p_ne, %c_ne;
    or.pred %match, %match, %p_ne;
    selp.b32 %mask, 1, 0, %match;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %mask;
    add.u64 %i, %i, %stride;
    bra loop_ncc;
done_ncc:
    ret;
}

// ---- numeric (i128) BUFFER VM primitives -- checked add/sub arithmetic (the type matrix, doc 19) ----
// The i128 analogs of the i64 buffer kernels. Numeric arithmetic lowers to a postfix program over
// leased i128 buffers (16 bytes/element; the lease pool is cudaMalloc-backed = 8-byte aligned, so
// 8-byte loads on the buffers are safe). Add/sub are 2-limb (add.cc/addc, sub.cc/subc); CHECKED via
// the high-limb sign rule -- an overflow (the 128-bit result leaves i128 range) ORs the shared flag, so
// the host raises PG `numeric field overflow`. The resident LOAD reads the payload (possibly 4-mod-8
// aligned) as 4-byte words. op 0=add 1=sub. (i128*i128 multiply is a follow-on slice.)

// out[i] = column[i] : load a resident i128 column into an i128 buffer (4-byte reads; 4-mod-8 safe).
.visible .entry gpu_db_resident_i128_load_column(
    .param .u64 resident_ptr,
    .param .u64 byte_offset,
    .param .u64 n,
    .param .u64 out_ptr
)
{
    .reg .pred %p;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .b32 %w0;
    .reg .b32 %w1;
    .reg .b32 %w2;
    .reg .b32 %w3;
    .reg .u64 %src;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o16;
    .reg .u64 %addr;

    ld.param.u64 %src, [resident_ptr];
    ld.param.u64 %addr, [byte_offset];
    add.u64 %src, %src, %addr;
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_ld128:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_ld128;
    mul.lo.u64 %o16, %i, 16;
    add.u64 %addr, %src, %o16;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    ld.global.u32 %w2, [%addr+8];
    ld.global.u32 %w3, [%addr+12];
    add.u64 %addr, %out, %o16;
    st.global.u32 [%addr], %w0;
    st.global.u32 [%addr+4], %w1;
    st.global.u32 [%addr+8], %w2;
    st.global.u32 [%addr+12], %w3;
    add.u64 %i, %i, %stride;
    bra loop_ld128;
done_ld128:
    ret;
}

// out[i] = a[i] <op> b[i] : checked int128 add/sub over two i128 buffers. op 0=add 1=sub.
.visible .entry gpu_db_buffer_i128_binary(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u32 op_code,
    .param .u64 n,
    .param .u64 out_ptr,
    .param .u64 out_overflow_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_sub;
    .reg .pred %pcarry;
    .reg .pred %c1;
    .reg .pred %c2;
    .reg .pred %pp;
    .reg .pred %p_ovf;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %op;
    .reg .u32 %one;
    .reg .u32 %o_add;
    .reg .u32 %o_sub;
    .reg .u32 %ovf_val;
    .reg .b64 %a_lo;
    .reg .b64 %a_hi;
    .reg .b64 %b_lo;
    .reg .b64 %b_hi;
    .reg .b64 %radd_lo;
    .reg .b64 %radd_hi;
    .reg .b64 %rsub_lo;
    .reg .b64 %rsub_hi;
    .reg .b64 %r_lo;
    .reg .b64 %r_hi;
    .reg .b64 %t;
    .reg .u64 %a;
    .reg .u64 %b;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %ovf;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o16;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.u64 %b, [b_ptr];
    ld.param.u32 %op, [op_code];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_ptr];
    ld.param.u64 %ovf, [out_overflow_ptr];
    mov.u32 %one, 1;
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_bb128:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_bb128;
    mul.lo.u64 %o16, %i, 16;
    add.u64 %addr, %a, %o16;
    ld.global.u64 %a_lo, [%addr];
    ld.global.u64 %a_hi, [%addr+8];
    add.u64 %addr, %b, %o16;
    ld.global.u64 %b_lo, [%addr];
    ld.global.u64 %b_hi, [%addr+8];
    // ADD (default result): 2-limb add with a manual carry (carry = the low sum wrapped); overflow if
    // a,b same sign and result differs.
    add.u64 %radd_lo, %a_lo, %b_lo;
    setp.lt.u64 %pcarry, %radd_lo, %a_lo;
    add.u64 %radd_hi, %a_hi, %b_hi;
    selp.u64 %t, 1, 0, %pcarry;
    add.u64 %radd_hi, %radd_hi, %t;
    xor.b64 %t, %a_hi, %b_hi;
    setp.ge.s64 %c1, %t, 0;
    xor.b64 %t, %a_hi, %radd_hi;
    setp.lt.s64 %c2, %t, 0;
    and.pred %pp, %c1, %c2;
    selp.u32 %o_add, 1, 0, %pp;
    mov.b64 %r_lo, %radd_lo;
    mov.b64 %r_hi, %radd_hi;
    mov.u32 %ovf_val, %o_add;
    // SUB (op==1): 2-limb sub with a manual borrow (borrow = a_lo < b_lo); overflow if a,b differ in
    // sign and result differs from a.
    sub.u64 %rsub_lo, %a_lo, %b_lo;
    setp.lt.u64 %pcarry, %a_lo, %b_lo;
    sub.u64 %rsub_hi, %a_hi, %b_hi;
    selp.u64 %t, 1, 0, %pcarry;
    sub.u64 %rsub_hi, %rsub_hi, %t;
    xor.b64 %t, %a_hi, %b_hi;
    setp.lt.s64 %c1, %t, 0;
    xor.b64 %t, %a_hi, %rsub_hi;
    setp.lt.s64 %c2, %t, 0;
    and.pred %pp, %c1, %c2;
    selp.u32 %o_sub, 1, 0, %pp;
    setp.eq.u32 %p_sub, %op, 1;
    @%p_sub mov.b64 %r_lo, %rsub_lo;
    @%p_sub mov.b64 %r_hi, %rsub_hi;
    @%p_sub mov.u32 %ovf_val, %o_sub;
    // This kernel computes add/sub ONLY; op > 1 (e.g. a future miswired i128 multiply, which belongs
    // in the dedicated mul kernel) must NOT silently return the add result -- trap it as overflow so
    // it fails loudly (PG `numeric field overflow`) instead of a wrong answer.
    setp.gt.u32 %pp, %op, 1;
    @%pp red.global.or.b32 [%ovf], %one;
    setp.ne.u32 %p_ovf, %ovf_val, 0;
    @%p_ovf red.global.or.b32 [%ovf], %one;
    add.u64 %addr, %out, %o16;
    st.global.u64 [%addr], %r_lo;
    st.global.u64 [%addr+8], %r_hi;
    add.u64 %i, %i, %stride;
    bra loop_bb128;
done_bb128:
    ret;
}

// out[i] = scalar_on_left ? (s <op> a[i]) : (a[i] <op> s) : checked int128 add/sub, buffer + scalar.
.visible .entry gpu_db_buffer_i128_binary_scalar(
    .param .u64 a_ptr,
    .param .u64 scalar_lo,
    .param .u64 scalar_hi,
    .param .u32 op_code,
    .param .u32 scalar_on_left,
    .param .u64 n,
    .param .u64 out_ptr,
    .param .u64 out_overflow_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_sub;
    .reg .pred %p_left;
    .reg .pred %c1;
    .reg .pred %c2;
    .reg .pred %pp;
    .reg .pred %p_ovf;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %op;
    .reg .u32 %onleft;
    .reg .u32 %one;
    .reg .u32 %o_add;
    .reg .u32 %o_sub;
    .reg .u32 %ovf_val;
    .reg .b64 %a_lo;
    .reg .b64 %a_hi;
    .reg .b64 %s_lo;
    .reg .b64 %s_hi;
    .reg .b64 %lhs_lo;
    .reg .b64 %lhs_hi;
    .reg .b64 %rhs_lo;
    .reg .b64 %rhs_hi;
    .reg .pred %pcarry;
    .reg .b64 %radd_lo;
    .reg .b64 %radd_hi;
    .reg .b64 %rsub_lo;
    .reg .b64 %rsub_hi;
    .reg .b64 %r_lo;
    .reg .b64 %r_hi;
    .reg .b64 %t;
    .reg .u64 %a;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %ovf;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o16;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.u64 %s_lo, [scalar_lo];
    ld.param.u64 %s_hi, [scalar_hi];
    ld.param.u32 %op, [op_code];
    ld.param.u32 %onleft, [scalar_on_left];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_ptr];
    ld.param.u64 %ovf, [out_overflow_ptr];
    mov.u32 %one, 1;
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_bs128:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_bs128;
    mul.lo.u64 %o16, %i, 16;
    add.u64 %addr, %a, %o16;
    ld.global.u64 %a_lo, [%addr];
    ld.global.u64 %a_hi, [%addr+8];
    setp.ne.u32 %p_left, %onleft, 0;
    mov.b64 %lhs_lo, %a_lo;
    mov.b64 %lhs_hi, %a_hi;
    mov.b64 %rhs_lo, %s_lo;
    mov.b64 %rhs_hi, %s_hi;
    @%p_left mov.b64 %lhs_lo, %s_lo;
    @%p_left mov.b64 %lhs_hi, %s_hi;
    @%p_left mov.b64 %rhs_lo, %a_lo;
    @%p_left mov.b64 %rhs_hi, %a_hi;
    add.u64 %radd_lo, %lhs_lo, %rhs_lo;
    setp.lt.u64 %pcarry, %radd_lo, %lhs_lo;
    add.u64 %radd_hi, %lhs_hi, %rhs_hi;
    selp.u64 %t, 1, 0, %pcarry;
    add.u64 %radd_hi, %radd_hi, %t;
    xor.b64 %t, %lhs_hi, %rhs_hi;
    setp.ge.s64 %c1, %t, 0;
    xor.b64 %t, %lhs_hi, %radd_hi;
    setp.lt.s64 %c2, %t, 0;
    and.pred %pp, %c1, %c2;
    selp.u32 %o_add, 1, 0, %pp;
    mov.b64 %r_lo, %radd_lo;
    mov.b64 %r_hi, %radd_hi;
    mov.u32 %ovf_val, %o_add;
    sub.u64 %rsub_lo, %lhs_lo, %rhs_lo;
    setp.lt.u64 %pcarry, %lhs_lo, %rhs_lo;
    sub.u64 %rsub_hi, %lhs_hi, %rhs_hi;
    selp.u64 %t, 1, 0, %pcarry;
    sub.u64 %rsub_hi, %rsub_hi, %t;
    xor.b64 %t, %lhs_hi, %rhs_hi;
    setp.lt.s64 %c1, %t, 0;
    xor.b64 %t, %lhs_hi, %rsub_hi;
    setp.lt.s64 %c2, %t, 0;
    and.pred %pp, %c1, %c2;
    selp.u32 %o_sub, 1, 0, %pp;
    setp.eq.u32 %p_sub, %op, 1;
    @%p_sub mov.b64 %r_lo, %rsub_lo;
    @%p_sub mov.b64 %r_hi, %rsub_hi;
    @%p_sub mov.u32 %ovf_val, %o_sub;
    // This kernel computes add/sub ONLY; op > 1 (e.g. a future miswired i128 multiply, which belongs
    // in the dedicated mul kernel) must NOT silently return the add result -- trap it as overflow so
    // it fails loudly (PG `numeric field overflow`) instead of a wrong answer.
    setp.gt.u32 %pp, %op, 1;
    @%pp red.global.or.b32 [%ovf], %one;
    setp.ne.u32 %p_ovf, %ovf_val, 0;
    @%p_ovf red.global.or.b32 [%ovf], %one;
    add.u64 %addr, %out, %o16;
    st.global.u64 [%addr], %r_lo;
    st.global.u64 [%addr+8], %r_hi;
    add.u64 %i, %i, %stride;
    bra loop_bs128;
done_bs128:
    ret;
}

// out_mask[i] = ( scalar_on_left ? (s <cmp> a[i]) : (a[i] <cmp> s) ) ? 1 : 0  over an i128 buffer.
.visible .entry gpu_db_buffer_i128_compare_scalar_to_mask(
    .param .u64 a_ptr,
    .param .u64 scalar_lo,
    .param .u64 scalar_hi,
    .param .u32 scalar_on_left,
    .param .u32 comparison,
    .param .u64 n,
    .param .u64 out_mask_ptr
)
{
    .reg .pred %p;
    .reg .pred %p_left;
    .reg .pred %hi_eq;
    .reg .pred %hi_lt;
    .reg .pred %hi_gt;
    .reg .pred %lo_eq;
    .reg .pred %lo_lt;
    .reg .pred %lo_gt;
    .reg .pred %p_eq;
    .reg .pred %p_lt;
    .reg .pred %p_le;
    .reg .pred %p_gt;
    .reg .pred %p_ge;
    .reg .pred %p_ne;
    .reg .pred %tmp;
    .reg .pred %c_eq;
    .reg .pred %c_lt;
    .reg .pred %c_le;
    .reg .pred %c_gt;
    .reg .pred %c_ge;
    .reg .pred %c_ne;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %cmp;
    .reg .u32 %onleft;
    .reg .b64 %s_lo;
    .reg .b64 %s_hi;
    .reg .b64 %a_lo;
    .reg .b64 %a_hi;
    .reg .b64 %lhs_lo;
    .reg .b64 %lhs_hi;
    .reg .b64 %rhs_lo;
    .reg .b64 %rhs_hi;
    .reg .b32 %mask;
    .reg .u64 %a;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o16;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.u64 %s_lo, [scalar_lo];
    ld.param.u64 %s_hi, [scalar_hi];
    ld.param.u32 %onleft, [scalar_on_left];
    ld.param.u32 %cmp, [comparison];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_mask_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_bcs128:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_bcs128;
    mul.lo.u64 %o16, %i, 16;
    add.u64 %addr, %a, %o16;
    ld.global.u64 %a_lo, [%addr];
    ld.global.u64 %a_hi, [%addr+8];
    setp.ne.u32 %p_left, %onleft, 0;
    mov.b64 %lhs_lo, %a_lo;
    mov.b64 %lhs_hi, %a_hi;
    mov.b64 %rhs_lo, %s_lo;
    mov.b64 %rhs_hi, %s_hi;
    @%p_left mov.b64 %lhs_lo, %s_lo;
    @%p_left mov.b64 %lhs_hi, %s_hi;
    @%p_left mov.b64 %rhs_lo, %a_lo;
    @%p_left mov.b64 %rhs_hi, %a_hi;
    setp.eq.s64 %hi_eq, %lhs_hi, %rhs_hi;
    setp.lt.s64 %hi_lt, %lhs_hi, %rhs_hi;
    setp.gt.s64 %hi_gt, %lhs_hi, %rhs_hi;
    setp.eq.u64 %lo_eq, %lhs_lo, %rhs_lo;
    setp.lt.u64 %lo_lt, %lhs_lo, %rhs_lo;
    setp.gt.u64 %lo_gt, %lhs_lo, %rhs_lo;
    and.pred %p_eq, %hi_eq, %lo_eq;
    and.pred %tmp, %hi_eq, %lo_lt;
    or.pred %p_lt, %hi_lt, %tmp;
    and.pred %tmp, %hi_eq, %lo_gt;
    or.pred %p_gt, %hi_gt, %tmp;
    not.pred %p_le, %p_gt;
    not.pred %p_ge, %p_lt;
    not.pred %p_ne, %p_eq;
    setp.eq.u32 %c_eq, %cmp, 0;
    setp.eq.u32 %c_lt, %cmp, 1;
    setp.eq.u32 %c_le, %cmp, 2;
    setp.eq.u32 %c_gt, %cmp, 3;
    setp.eq.u32 %c_ge, %cmp, 4;
    setp.eq.u32 %c_ne, %cmp, 5;
    mov.pred %match, 0;
    and.pred %p_eq, %p_eq, %c_eq;
    or.pred %match, %match, %p_eq;
    and.pred %p_lt, %p_lt, %c_lt;
    or.pred %match, %match, %p_lt;
    and.pred %p_le, %p_le, %c_le;
    or.pred %match, %match, %p_le;
    and.pred %p_gt, %p_gt, %c_gt;
    or.pred %match, %match, %p_gt;
    and.pred %p_ge, %p_ge, %c_ge;
    or.pred %match, %match, %p_ge;
    and.pred %p_ne, %p_ne, %c_ne;
    or.pred %match, %match, %p_ne;
    selp.b32 %mask, 1, 0, %match;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %mask;
    add.u64 %i, %i, %stride;
    bra loop_bcs128;
done_bcs128:
    ret;
}

// out_mask[i] = (a[i] <cmp> b[i]) ? 1 : 0  over two i128 buffers.
.visible .entry gpu_db_buffer_i128_compare_buffers_to_mask(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u32 comparison,
    .param .u64 n,
    .param .u64 out_mask_ptr
)
{
    .reg .pred %p;
    .reg .pred %hi_eq;
    .reg .pred %hi_lt;
    .reg .pred %hi_gt;
    .reg .pred %lo_eq;
    .reg .pred %lo_lt;
    .reg .pred %lo_gt;
    .reg .pred %p_eq;
    .reg .pred %p_lt;
    .reg .pred %p_le;
    .reg .pred %p_gt;
    .reg .pred %p_ge;
    .reg .pred %p_ne;
    .reg .pred %tmp;
    .reg .pred %c_eq;
    .reg .pred %c_lt;
    .reg .pred %c_le;
    .reg .pred %c_gt;
    .reg .pred %c_ge;
    .reg .pred %c_ne;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %cmp;
    .reg .b64 %a_lo;
    .reg .b64 %a_hi;
    .reg .b64 %b_lo;
    .reg .b64 %b_hi;
    .reg .b32 %mask;
    .reg .u64 %a;
    .reg .u64 %b;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o16;
    .reg .u64 %o4;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.u64 %b, [b_ptr];
    ld.param.u32 %cmp, [comparison];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_mask_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_bcb128:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_bcb128;
    mul.lo.u64 %o16, %i, 16;
    add.u64 %addr, %a, %o16;
    ld.global.u64 %a_lo, [%addr];
    ld.global.u64 %a_hi, [%addr+8];
    add.u64 %addr, %b, %o16;
    ld.global.u64 %b_lo, [%addr];
    ld.global.u64 %b_hi, [%addr+8];
    setp.eq.s64 %hi_eq, %a_hi, %b_hi;
    setp.lt.s64 %hi_lt, %a_hi, %b_hi;
    setp.gt.s64 %hi_gt, %a_hi, %b_hi;
    setp.eq.u64 %lo_eq, %a_lo, %b_lo;
    setp.lt.u64 %lo_lt, %a_lo, %b_lo;
    setp.gt.u64 %lo_gt, %a_lo, %b_lo;
    and.pred %p_eq, %hi_eq, %lo_eq;
    and.pred %tmp, %hi_eq, %lo_lt;
    or.pred %p_lt, %hi_lt, %tmp;
    and.pred %tmp, %hi_eq, %lo_gt;
    or.pred %p_gt, %hi_gt, %tmp;
    not.pred %p_le, %p_gt;
    not.pred %p_ge, %p_lt;
    not.pred %p_ne, %p_eq;
    setp.eq.u32 %c_eq, %cmp, 0;
    setp.eq.u32 %c_lt, %cmp, 1;
    setp.eq.u32 %c_le, %cmp, 2;
    setp.eq.u32 %c_gt, %cmp, 3;
    setp.eq.u32 %c_ge, %cmp, 4;
    setp.eq.u32 %c_ne, %cmp, 5;
    mov.pred %match, 0;
    and.pred %p_eq, %p_eq, %c_eq;
    or.pred %match, %match, %p_eq;
    and.pred %p_lt, %p_lt, %c_lt;
    or.pred %match, %match, %p_lt;
    and.pred %p_le, %p_le, %c_le;
    or.pred %match, %match, %p_le;
    and.pred %p_gt, %p_gt, %c_gt;
    or.pred %match, %match, %p_gt;
    and.pred %p_ge, %p_ge, %c_ge;
    or.pred %match, %match, %p_ge;
    and.pred %p_ne, %p_ne, %c_ne;
    or.pred %match, %match, %p_ne;
    selp.b32 %mask, 1, 0, %match;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %mask;
    add.u64 %i, %i, %stride;
    bra loop_bcb128;
done_bcb128:
    ret;
}

// out[i] = a[i] * scalar : CHECKED signed int128 multiply (the scalar is a literal, widened to i128).
// Computes the full signed 256-bit product -- an unsigned 4-limb schoolbook of the 128-bit
// bit-patterns, then a sign correction (subtract s<<128 if a<0, a<<128 if s<0) -- keeps the low 128
// bits as the result, and flags overflow when the high 128 bits are NOT the sign-extension of the low
// 128 (the product left i128 range) -> PG `numeric field overflow`. op_code / scalar_on_left are
// ignored (multiply is commutative). The buffer is lease-pool (8-byte aligned), so 8-byte loads.
.visible .entry gpu_db_buffer_i128_mul_scalar(
    .param .u64 a_ptr,
    .param .u64 scalar_lo,
    .param .u64 scalar_hi,
    .param .u32 op_code,
    .param .u32 scalar_on_left,
    .param .u64 n,
    .param .u64 out_ptr,
    .param .u64 out_overflow_ptr
)
{
    .reg .pred %p;
    .reg .pred %a_neg;
    .reg .pred %s_neg;
    .reg .pred %ov1;
    .reg .pred %ov2;
    .reg .pred %p_ovf;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %one;
    .reg .b64 %a_lo;
    .reg .b64 %a_hi;
    .reg .b64 %s_lo;
    .reg .b64 %s_hi;
    .reg .b64 %r0;
    .reg .b64 %r1;
    .reg .b64 %r2;
    .reg .b64 %r3;
    .reg .b64 %pll_hi;
    .reg .b64 %plh_lo;
    .reg .b64 %plh_hi;
    .reg .b64 %phl_lo;
    .reg .b64 %phl_hi;
    .reg .b64 %phh_lo;
    .reg .b64 %phh_hi;
    .reg .b64 %cy1;
    .reg .b64 %cy1b;
    .reg .b64 %cy2;
    .reg .b64 %cy2b;
    .reg .b64 %cy2c;
    .reg .b64 %sgn;
    .reg .u64 %a;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %ovf;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o16;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.u64 %s_lo, [scalar_lo];
    ld.param.u64 %s_hi, [scalar_hi];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_ptr];
    ld.param.u64 %ovf, [out_overflow_ptr];
    mov.u32 %one, 1;
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_ms128:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_ms128;
    mul.lo.u64 %o16, %i, 16;
    add.u64 %addr, %a, %o16;
    ld.global.u64 %a_lo, [%addr];
    ld.global.u64 %a_hi, [%addr+8];
    // unsigned 4-limb product of the 128-bit bit-patterns (r3:r2:r1:r0)
    mul.lo.u64 %r0, %a_lo, %s_lo;
    mul.hi.u64 %pll_hi, %a_lo, %s_lo;
    mul.lo.u64 %plh_lo, %a_lo, %s_hi;
    mul.hi.u64 %plh_hi, %a_lo, %s_hi;
    mul.lo.u64 %phl_lo, %a_hi, %s_lo;
    mul.hi.u64 %phl_hi, %a_hi, %s_lo;
    mul.lo.u64 %phh_lo, %a_hi, %s_hi;
    mul.hi.u64 %phh_hi, %a_hi, %s_hi;
    // r1 = pll_hi + plh_lo + phl_lo (carries accumulate into cy1)
    add.cc.u64 %r1, %pll_hi, %plh_lo;
    addc.u64 %cy1, 0, 0;
    add.cc.u64 %r1, %r1, %phl_lo;
    addc.u64 %cy1b, 0, 0;
    add.u64 %cy1, %cy1, %cy1b;
    // r2 = plh_hi + phl_hi + phh_lo + cy1 (carries accumulate into cy2)
    add.cc.u64 %r2, %plh_hi, %phl_hi;
    addc.u64 %cy2, 0, 0;
    add.cc.u64 %r2, %r2, %phh_lo;
    addc.u64 %cy2b, 0, 0;
    add.cc.u64 %r2, %r2, %cy1;
    addc.u64 %cy2c, 0, 0;
    add.u64 %cy2, %cy2, %cy2b;
    add.u64 %cy2, %cy2, %cy2c;
    // r3 = phh_hi + cy2
    add.u64 %r3, %phh_hi, %cy2;
    // sign correction: if a < 0, (r3:r2) -= s; if s < 0, (r3:r2) -= a
    setp.lt.s64 %a_neg, %a_hi, 0;
    @%a_neg sub.cc.u64 %r2, %r2, %s_lo;
    @%a_neg subc.u64 %r3, %r3, %s_hi;
    setp.lt.s64 %s_neg, %s_hi, 0;
    @%s_neg sub.cc.u64 %r2, %r2, %a_lo;
    @%s_neg subc.u64 %r3, %r3, %a_hi;
    // result = (r1:r0); overflow if (r3:r2) is not the sign-extension of r1
    shr.s64 %sgn, %r1, 63;
    setp.ne.u64 %ov1, %r2, %sgn;
    setp.ne.u64 %ov2, %r3, %sgn;
    or.pred %p_ovf, %ov1, %ov2;
    @%p_ovf red.global.or.b32 [%ovf], %one;
    add.u64 %addr, %out, %o16;
    st.global.u64 [%addr], %r0;
    st.global.u64 [%addr+8], %r1;
    add.u64 %i, %i, %stride;
    bra loop_ms128;
done_ms128:
    ret;
}

// out[i] = a[i] * b[i] : CHECKED signed int128 column-times-column multiply (two i128 buffers). Same
// algorithm as gpu_db_buffer_i128_mul_scalar (unsigned 4-limb schoolbook + sign correction; overflow
// when the high 128 bits are not the sign-extension of the low 128) -> PG `numeric field overflow`.
// op_code is ignored (this kernel is only ever selected for multiply). Buffers are 8-byte aligned.
.visible .entry gpu_db_buffer_i128_mul(
    .param .u64 a_ptr,
    .param .u64 b_ptr,
    .param .u32 op_code,
    .param .u64 n,
    .param .u64 out_ptr,
    .param .u64 out_overflow_ptr
)
{
    .reg .pred %p;
    .reg .pred %a_neg;
    .reg .pred %b_neg;
    .reg .pred %ov1;
    .reg .pred %ov2;
    .reg .pred %p_ovf;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %one;
    .reg .b64 %a_lo;
    .reg .b64 %a_hi;
    .reg .b64 %b_lo;
    .reg .b64 %b_hi;
    .reg .b64 %r0;
    .reg .b64 %r1;
    .reg .b64 %r2;
    .reg .b64 %r3;
    .reg .b64 %pll_hi;
    .reg .b64 %plh_lo;
    .reg .b64 %plh_hi;
    .reg .b64 %phl_lo;
    .reg .b64 %phl_hi;
    .reg .b64 %phh_lo;
    .reg .b64 %phh_hi;
    .reg .b64 %cy1;
    .reg .b64 %cy1b;
    .reg .b64 %cy2;
    .reg .b64 %cy2b;
    .reg .b64 %cy2c;
    .reg .b64 %sgn;
    .reg .u64 %a;
    .reg .u64 %b;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %ovf;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o16;
    .reg .u64 %addr;

    ld.param.u64 %a, [a_ptr];
    ld.param.u64 %b, [b_ptr];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_ptr];
    ld.param.u64 %ovf, [out_overflow_ptr];
    mov.u32 %one, 1;
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_mb128:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_mb128;
    mul.lo.u64 %o16, %i, 16;
    add.u64 %addr, %a, %o16;
    ld.global.u64 %a_lo, [%addr];
    ld.global.u64 %a_hi, [%addr+8];
    add.u64 %addr, %b, %o16;
    ld.global.u64 %b_lo, [%addr];
    ld.global.u64 %b_hi, [%addr+8];
    // unsigned 4-limb product of the 128-bit bit-patterns (r3:r2:r1:r0)
    mul.lo.u64 %r0, %a_lo, %b_lo;
    mul.hi.u64 %pll_hi, %a_lo, %b_lo;
    mul.lo.u64 %plh_lo, %a_lo, %b_hi;
    mul.hi.u64 %plh_hi, %a_lo, %b_hi;
    mul.lo.u64 %phl_lo, %a_hi, %b_lo;
    mul.hi.u64 %phl_hi, %a_hi, %b_lo;
    mul.lo.u64 %phh_lo, %a_hi, %b_hi;
    mul.hi.u64 %phh_hi, %a_hi, %b_hi;
    // r1 = pll_hi + plh_lo + phl_lo (carries accumulate into cy1)
    add.cc.u64 %r1, %pll_hi, %plh_lo;
    addc.u64 %cy1, 0, 0;
    add.cc.u64 %r1, %r1, %phl_lo;
    addc.u64 %cy1b, 0, 0;
    add.u64 %cy1, %cy1, %cy1b;
    // r2 = plh_hi + phl_hi + phh_lo + cy1 (carries accumulate into cy2)
    add.cc.u64 %r2, %plh_hi, %phl_hi;
    addc.u64 %cy2, 0, 0;
    add.cc.u64 %r2, %r2, %phh_lo;
    addc.u64 %cy2b, 0, 0;
    add.cc.u64 %r2, %r2, %cy1;
    addc.u64 %cy2c, 0, 0;
    add.u64 %cy2, %cy2, %cy2b;
    add.u64 %cy2, %cy2, %cy2c;
    // r3 = phh_hi + cy2
    add.u64 %r3, %phh_hi, %cy2;
    // sign correction: if a < 0, (r3:r2) -= b; if b < 0, (r3:r2) -= a
    setp.lt.s64 %a_neg, %a_hi, 0;
    @%a_neg sub.cc.u64 %r2, %r2, %b_lo;
    @%a_neg subc.u64 %r3, %r3, %b_hi;
    setp.lt.s64 %b_neg, %b_hi, 0;
    @%b_neg sub.cc.u64 %r2, %r2, %a_lo;
    @%b_neg subc.u64 %r3, %r3, %a_hi;
    // result = (r1:r0); overflow if (r3:r2) is not the sign-extension of r1
    shr.s64 %sgn, %r1, 63;
    setp.ne.u64 %ov1, %r2, %sgn;
    setp.ne.u64 %ov2, %r3, %sgn;
    or.pred %p_ovf, %ov1, %ov2;
    @%p_ovf red.global.or.b32 [%ovf], %one;
    add.u64 %addr, %out, %o16;
    st.global.u64 [%addr], %r0;
    st.global.u64 [%addr+8], %r1;
    add.u64 %i, %i, %stride;
    bra loop_mb128;
done_mb128:
    ret;
}

// out_mask[i] = ((text[i] == needle) XOR negate) ? 1 : 0  over a resident TEXT column (the type
// matrix, doc 19). The column is offsets[n+1] (u64 LE, at resident_ptr + offsets_byte_offset) plus a
// byte blob (at resident_ptr + bytes_byte_offset); row i's bytes are blob[offsets[i] .. offsets[i+1]].
// needle_ptr is a device copy of the literal bytes (needle_len long). Byte-wise equality -- PG
// deterministic-collation equality is byte identity. negate=1 evaluates <> (NOT equal). The offsets
// are read as 2x 4-byte loads: the text section can land 4-mod-8 aligned, where an 8-byte load faults
// 716 (sticky) -- same constraint as the int8/i128 resident kernels.
.visible .entry gpu_db_resident_text_eq_scalar_to_mask(
    .param .u64 resident_ptr,
    .param .u64 offsets_byte_offset,
    .param .u64 bytes_byte_offset,
    .param .u64 needle_ptr,
    .param .u64 needle_len,
    .param .u32 negate,
    .param .u64 n,
    .param .u64 out_mask_ptr
)
{
    .reg .pred %p;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %neg;
    .reg .u32 %eqflag;
    .reg .u32 %w0;
    .reg .u32 %w1;
    .reg .u32 %abyte;
    .reg .u32 %bbyte;
    .reg .b32 %mask;
    .reg .u64 %off_base;
    .reg .u64 %bytes_base;
    .reg .u64 %needle;
    .reg .u64 %nlen;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o8;
    .reg .u64 %o4;
    .reg .u64 %addr;
    .reg .u64 %start;
    .reg .u64 %end;
    .reg .u64 %len;
    .reg .u64 %j;
    .reg .u64 %taddr;
    .reg .u64 %a_addr;
    .reg .u64 %b_addr;

    ld.param.u64 %off_base, [resident_ptr];
    ld.param.u64 %addr, [offsets_byte_offset];
    add.u64 %off_base, %off_base, %addr;
    ld.param.u64 %bytes_base, [resident_ptr];
    ld.param.u64 %addr, [bytes_byte_offset];
    add.u64 %bytes_base, %bytes_base, %addr;
    ld.param.u64 %needle, [needle_ptr];
    ld.param.u64 %nlen, [needle_len];
    ld.param.u32 %neg, [negate];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_mask_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_teq:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_teq;
    mul.lo.u64 %o8, %i, 8;
    add.u64 %addr, %off_base, %o8;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    mov.b64 %start, {%w0, %w1};
    ld.global.u32 %w0, [%addr+8];
    ld.global.u32 %w1, [%addr+12];
    mov.b64 %end, {%w0, %w1};
    sub.u64 %len, %end, %start;
    mov.u32 %eqflag, 1;
    setp.ne.u64 %p, %len, %nlen;
    @%p bra teq_store_zero;
    add.u64 %taddr, %bytes_base, %start;
    mov.u64 %j, 0;
teq_byte:
    setp.ge.u64 %p, %j, %nlen;
    @%p bra teq_after;
    add.u64 %a_addr, %taddr, %j;
    ld.global.u8 %abyte, [%a_addr];
    add.u64 %b_addr, %needle, %j;
    ld.global.u8 %bbyte, [%b_addr];
    setp.ne.u32 %p, %abyte, %bbyte;
    @%p bra teq_store_zero;
    add.u64 %j, %j, 1;
    bra teq_byte;
teq_store_zero:
    mov.u32 %eqflag, 0;
teq_after:
    setp.ne.u32 %match, %eqflag, %neg;
    selp.b32 %mask, 1, 0, %match;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %mask;
    add.u64 %i, %i, %stride;
    bra loop_teq;
done_teq:
    ret;
}

// out_mask[i] = (text[i] LIKE pattern) ? 1 : 0  over a resident TEXT column (the type matrix, doc 19).
// `pattern` is a device u32 TOKEN array (ntok tokens) compiled on the host (escapes resolved): each
// token = (op<<8)|literal_byte, op 0=literal byte, 1=any-one (`_`), 2=any-run (`%`). Iterative
// backtracking wildcard match: `_` and `%` advance the TEXT by one full UTF-8 character (lead-byte
// length, so multi-byte text is PG-correct); literal tokens match byte-by-byte. Offsets read as 2x
// 4-byte loads (the section can land 4-mod-8 aligned, where an 8-byte load faults 716).
.visible .entry gpu_db_resident_text_like_scalar_to_mask(
    .param .u64 resident_ptr,
    .param .u64 offsets_byte_offset,
    .param .u64 bytes_byte_offset,
    .param .u64 tokens_ptr,
    .param .u64 ntok,
    .param .u64 n,
    .param .u64 out_mask_ptr
)
{
    .reg .pred %p;
    .reg .pred %pm;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %w0;
    .reg .u32 %w1;
    .reg .u32 %tokw;
    .reg .u32 %op;
    .reg .u32 %lit;
    .reg .u32 %tb;
    .reg .u32 %has_star;
    .reg .b32 %mask;
    .reg .u64 %off_base;
    .reg .u64 %bytes_base;
    .reg .u64 %tok_base;
    .reg .u64 %ntok;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o8;
    .reg .u64 %o4;
    .reg .u64 %addr;
    .reg .u64 %start;
    .reg .u64 %end;
    .reg .u64 %tlen;
    .reg .u64 %textbase;
    .reg .u64 %s;
    .reg .u64 %pp;
    .reg .u64 %star_p;
    .reg .u64 %sstar;
    .reg .u64 %clen;
    .reg .u64 %toff;

    ld.param.u64 %off_base, [resident_ptr];
    ld.param.u64 %addr, [offsets_byte_offset];
    add.u64 %off_base, %off_base, %addr;
    ld.param.u64 %bytes_base, [resident_ptr];
    ld.param.u64 %addr, [bytes_byte_offset];
    add.u64 %bytes_base, %bytes_base, %addr;
    ld.param.u64 %tok_base, [tokens_ptr];
    ld.param.u64 %ntok, [ntok];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_mask_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_tlike:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_tlike;
    mul.lo.u64 %o8, %i, 8;
    add.u64 %addr, %off_base, %o8;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    mov.b64 %start, {%w0, %w1};
    ld.global.u32 %w0, [%addr+8];
    ld.global.u32 %w1, [%addr+12];
    mov.b64 %end, {%w0, %w1};
    sub.u64 %tlen, %end, %start;
    add.u64 %textbase, %bytes_base, %start;
    mov.u64 %s, 0;
    mov.u64 %pp, 0;
    mov.u32 %has_star, 0;
    mov.u64 %star_p, 0;
    mov.u64 %sstar, 0;
mloop:
    setp.ge.u64 %p, %s, %tlen;
    @%p bra mdone;
    setp.ge.u64 %p, %pp, %ntok;
    @%p bra mback;
    mul.lo.u64 %toff, %pp, 4;
    add.u64 %addr, %tok_base, %toff;
    ld.global.u32 %tokw, [%addr];
    shr.u32 %op, %tokw, 8;
    and.b32 %lit, %tokw, 255;
    setp.eq.u32 %p, %op, 2;
    @%p bra mstar;
    setp.eq.u32 %p, %op, 1;
    @%p bra manyone;
    add.u64 %addr, %textbase, %s;
    ld.global.u8 %tb, [%addr];
    setp.ne.u32 %p, %tb, %lit;
    @%p bra mback;
    add.u64 %s, %s, 1;
    add.u64 %pp, %pp, 1;
    bra mloop;
manyone:
    add.u64 %addr, %textbase, %s;
    ld.global.u8 %tb, [%addr];
    mov.u64 %clen, 1;
    setp.lt.u32 %p, %tb, 192;
    @%p bra manyone_adv;
    mov.u64 %clen, 2;
    setp.lt.u32 %p, %tb, 224;
    @%p bra manyone_adv;
    mov.u64 %clen, 3;
    setp.lt.u32 %p, %tb, 240;
    @%p bra manyone_adv;
    mov.u64 %clen, 4;
manyone_adv:
    add.u64 %s, %s, %clen;
    add.u64 %pp, %pp, 1;
    bra mloop;
mstar:
    mov.u32 %has_star, 1;
    mov.u64 %star_p, %pp;
    mov.u64 %sstar, %s;
    add.u64 %pp, %pp, 1;
    bra mloop;
mback:
    setp.eq.u32 %p, %has_star, 0;
    @%p bra mfail;
    add.u64 %pp, %star_p, 1;
    add.u64 %addr, %textbase, %sstar;
    ld.global.u8 %tb, [%addr];
    mov.u64 %clen, 1;
    setp.lt.u32 %p, %tb, 192;
    @%p bra mback_adv;
    mov.u64 %clen, 2;
    setp.lt.u32 %p, %tb, 224;
    @%p bra mback_adv;
    mov.u64 %clen, 3;
    setp.lt.u32 %p, %tb, 240;
    @%p bra mback_adv;
    mov.u64 %clen, 4;
mback_adv:
    add.u64 %sstar, %sstar, %clen;
    mov.u64 %s, %sstar;
    bra mloop;
mdone:
    setp.ge.u64 %p, %pp, %ntok;
    @%p bra mcheck;
    mul.lo.u64 %toff, %pp, 4;
    add.u64 %addr, %tok_base, %toff;
    ld.global.u32 %tokw, [%addr];
    shr.u32 %op, %tokw, 8;
    setp.ne.u32 %p, %op, 2;
    @%p bra mcheck;
    add.u64 %pp, %pp, 1;
    bra mdone;
mcheck:
    setp.eq.u64 %pm, %pp, %ntok;
    selp.b32 %mask, 1, 0, %pm;
    bra mwrite;
mfail:
    mov.b32 %mask, 0;
mwrite:
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %mask;
    add.u64 %i, %i, %stride;
    bra loop_tlike;
done_tlike:
    ret;
}

// out_mask[i] = (uuid[i] <cmp> needle) ? 1 : 0  over a resident UUID column (16 raw bytes at
// resident_ptr + byte_offset + i*16). needle_ptr is a 16-byte device copy of the literal uuid. The
// compare is an unsigned big-endian 16-byte memcmp (PG's uuid order): the first differing byte (read
// as an unsigned u8) decides. cmp: 0=eq, 1=lt, 2=le, 3=gt, 4=ge, 5=ne. scalar_on_left reverses the
// operand order (literal <cmp> column) by negating the comparison sign. Bytes read with ld.global.u8
// (always aligned) so the 16-byte section's alignment never faults.
.visible .entry gpu_db_resident_uuid_compare_scalar_to_mask(
    .param .u64 resident_ptr,
    .param .u64 byte_offset,
    .param .u64 needle_ptr,
    .param .u32 scalar_on_left,
    .param .u32 comparison,
    .param .u64 n,
    .param .u64 out_mask_ptr
)
{
    .reg .pred %p;
    .reg .pred %ceq;
    .reg .pred %clt;
    .reg .pred %cle;
    .reg .pred %cgt;
    .reg .pred %cge;
    .reg .pred %cne;
    .reg .pred %req;
    .reg .pred %rlt;
    .reg .pred %rle;
    .reg .pred %rgt;
    .reg .pred %rge;
    .reg .pred %rne;
    .reg .pred %tmp;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %onleft;
    .reg .u32 %cmp;
    .reg .u32 %abyte;
    .reg .u32 %bbyte;
    .reg .s32 %ord;
    .reg .b32 %mask;
    .reg .u64 %base;
    .reg .u64 %needle;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o16;
    .reg .u64 %o4;
    .reg .u64 %addr;
    .reg .u64 %rowbase;
    .reg .u64 %j;
    .reg .u64 %a_addr;
    .reg .u64 %b_addr;

    ld.param.u64 %base, [resident_ptr];
    ld.param.u64 %addr, [byte_offset];
    add.u64 %base, %base, %addr;
    ld.param.u64 %needle, [needle_ptr];
    ld.param.u32 %onleft, [scalar_on_left];
    ld.param.u32 %cmp, [comparison];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_mask_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_uuid:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_uuid;
    mul.lo.u64 %o16, %i, 16;
    add.u64 %rowbase, %base, %o16;
    mov.s32 %ord, 0;
    mov.u64 %j, 0;
uuid_byte:
    setp.ge.u64 %p, %j, 16;
    @%p bra uuid_after;
    add.u64 %a_addr, %rowbase, %j;
    ld.global.u8 %abyte, [%a_addr];
    add.u64 %b_addr, %needle, %j;
    ld.global.u8 %bbyte, [%b_addr];
    setp.eq.u32 %p, %abyte, %bbyte;
    @%p bra uuid_byte_next;
    mov.s32 %ord, 1;
    setp.lt.u32 %p, %abyte, %bbyte;
    @%p mov.s32 %ord, -1;
    bra uuid_after;
uuid_byte_next:
    add.u64 %j, %j, 1;
    bra uuid_byte;
uuid_after:
    setp.ne.u32 %p, %onleft, 0;
    @%p neg.s32 %ord, %ord;
    setp.eq.u32 %ceq, %cmp, 0;
    setp.eq.u32 %clt, %cmp, 1;
    setp.eq.u32 %cle, %cmp, 2;
    setp.eq.u32 %cgt, %cmp, 3;
    setp.eq.u32 %cge, %cmp, 4;
    setp.eq.u32 %cne, %cmp, 5;
    setp.eq.s32 %req, %ord, 0;
    setp.lt.s32 %rlt, %ord, 0;
    setp.le.s32 %rle, %ord, 0;
    setp.gt.s32 %rgt, %ord, 0;
    setp.ge.s32 %rge, %ord, 0;
    setp.ne.s32 %rne, %ord, 0;
    mov.pred %match, 0;
    and.pred %tmp, %ceq, %req;
    or.pred %match, %match, %tmp;
    and.pred %tmp, %clt, %rlt;
    or.pred %match, %match, %tmp;
    and.pred %tmp, %cle, %rle;
    or.pred %match, %match, %tmp;
    and.pred %tmp, %cgt, %rgt;
    or.pred %match, %match, %tmp;
    and.pred %tmp, %cge, %rge;
    or.pred %match, %match, %tmp;
    and.pred %tmp, %cne, %rne;
    or.pred %match, %match, %tmp;
    selp.b32 %mask, 1, 0, %match;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %mask;
    add.u64 %i, %i, %stride;
    bra loop_uuid;
done_uuid:
    ret;
}

// out_mask[i] = (a[i] <cmp> b[i]) ? 1 : 0  over two resident UUID columns (16 raw bytes each, at
// resident_ptr + a_byte_offset/+ b_byte_offset + i*16). Unsigned big-endian 16-byte memcmp; cmp codes
// as above. Bytes read with ld.global.u8 (alignment-safe).
.visible .entry gpu_db_resident_uuid_compare_columns_to_mask(
    .param .u64 resident_ptr,
    .param .u64 a_byte_offset,
    .param .u64 b_byte_offset,
    .param .u32 comparison,
    .param .u64 n,
    .param .u64 out_mask_ptr
)
{
    .reg .pred %p;
    .reg .pred %ceq;
    .reg .pred %clt;
    .reg .pred %cle;
    .reg .pred %cgt;
    .reg .pred %cge;
    .reg .pred %cne;
    .reg .pred %req;
    .reg .pred %rlt;
    .reg .pred %rle;
    .reg .pred %rgt;
    .reg .pred %rge;
    .reg .pred %rne;
    .reg .pred %tmp;
    .reg .pred %match;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %cmp;
    .reg .u32 %abyte;
    .reg .u32 %bbyte;
    .reg .s32 %ord;
    .reg .b32 %mask;
    .reg .u64 %abase;
    .reg .u64 %bbase;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o16;
    .reg .u64 %o4;
    .reg .u64 %addr;
    .reg .u64 %arow;
    .reg .u64 %brow;
    .reg .u64 %j;
    .reg .u64 %a_addr;
    .reg .u64 %b_addr;

    ld.param.u64 %abase, [resident_ptr];
    ld.param.u64 %addr, [a_byte_offset];
    add.u64 %abase, %abase, %addr;
    ld.param.u64 %bbase, [resident_ptr];
    ld.param.u64 %addr, [b_byte_offset];
    add.u64 %bbase, %bbase, %addr;
    ld.param.u32 %cmp, [comparison];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_mask_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_uuidc:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_uuidc;
    mul.lo.u64 %o16, %i, 16;
    add.u64 %arow, %abase, %o16;
    add.u64 %brow, %bbase, %o16;
    mov.s32 %ord, 0;
    mov.u64 %j, 0;
uuidc_byte:
    setp.ge.u64 %p, %j, 16;
    @%p bra uuidc_after;
    add.u64 %a_addr, %arow, %j;
    ld.global.u8 %abyte, [%a_addr];
    add.u64 %b_addr, %brow, %j;
    ld.global.u8 %bbyte, [%b_addr];
    setp.eq.u32 %p, %abyte, %bbyte;
    @%p bra uuidc_byte_next;
    mov.s32 %ord, 1;
    setp.lt.u32 %p, %abyte, %bbyte;
    @%p mov.s32 %ord, -1;
    bra uuidc_after;
uuidc_byte_next:
    add.u64 %j, %j, 1;
    bra uuidc_byte;
uuidc_after:
    setp.eq.u32 %ceq, %cmp, 0;
    setp.eq.u32 %clt, %cmp, 1;
    setp.eq.u32 %cle, %cmp, 2;
    setp.eq.u32 %cgt, %cmp, 3;
    setp.eq.u32 %cge, %cmp, 4;
    setp.eq.u32 %cne, %cmp, 5;
    setp.eq.s32 %req, %ord, 0;
    setp.lt.s32 %rlt, %ord, 0;
    setp.le.s32 %rle, %ord, 0;
    setp.gt.s32 %rgt, %ord, 0;
    setp.ge.s32 %rge, %ord, 0;
    setp.ne.s32 %rne, %ord, 0;
    mov.pred %match, 0;
    and.pred %tmp, %ceq, %req;
    or.pred %match, %match, %tmp;
    and.pred %tmp, %clt, %rlt;
    or.pred %match, %match, %tmp;
    and.pred %tmp, %cle, %rle;
    or.pred %match, %match, %tmp;
    and.pred %tmp, %cgt, %rgt;
    or.pred %match, %match, %tmp;
    and.pred %tmp, %cge, %rge;
    or.pred %match, %match, %tmp;
    and.pred %tmp, %cne, %rne;
    or.pred %match, %match, %tmp;
    selp.b32 %mask, 1, 0, %match;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %mask;
    add.u64 %i, %i, %stride;
    bra loop_uuidc;
done_uuidc:
    ret;
}

// out_mask[i] = (bit i of a 1-bit-per-row bool BITMAP) XOR negate, as an i32 0/1 mask (the type
// matrix, doc 19). The bitmap is LE u32 words at resident_ptr + bitmap_byte_offset; bit i is bit
// (i & 31) of word (i >> 5). negate flips it (for NOT flag / flag = false). The word load is 4-byte
// aligned (the bool section starts 4-aligned and words are 4 bytes), so no misaligned-access fault.
.visible .entry gpu_db_resident_bool_to_mask(
    .param .u64 resident_ptr,
    .param .u64 bitmap_byte_offset,
    .param .u32 negate,
    .param .u64 n,
    .param .u64 out_mask_ptr
)
{
    .reg .pred %p;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %neg;
    .reg .u32 %word;
    .reg .u32 %bitpos;
    .reg .u32 %bit;
    .reg .u64 %base;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %widx;
    .reg .u64 %woff;
    .reg .u64 %addr;
    .reg .u64 %o4;

    ld.param.u64 %base, [resident_ptr];
    ld.param.u64 %addr, [bitmap_byte_offset];
    add.u64 %base, %base, %addr;
    ld.param.u32 %neg, [negate];
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_mask_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_bool:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_bool;
    shr.u64 %widx, %i, 5;
    mul.lo.u64 %woff, %widx, 4;
    add.u64 %addr, %base, %woff;
    ld.global.u32 %word, [%addr];
    cvt.u32.u64 %t32, %i;
    and.b32 %bitpos, %t32, 31;
    shr.u32 %bit, %word, %bitpos;
    and.b32 %bit, %bit, 1;
    setp.ne.u32 %p, %neg, 0;
    @%p xor.b32 %bit, %bit, 1;
    mul.lo.u64 %o4, %i, 4;
    add.u64 %addr, %out, %o4;
    st.global.b32 [%addr], %bit;
    add.u64 %i, %i, %stride;
    bra loop_bool;
done_bool:
    ret;
}

// Composite GROUP BY key (2 fixed-width int4-section columns): pack two i32 columns into one i64 derived
// key per row -- col0 in the high 32 bits, col1 in the low 32 bits. Bijective (each (col0,col1) -> a
// distinct i64) and reversible (the executor unpacks the result key). No atomics/hash (a pure MAP) so it
// cannot reintroduce the bool-kernel concurrency hazard. The i64 group path then groups by the override.
.visible .entry gpu_db_pack_two_int4_cols(
    .param .u64 resident_ptr,
    .param .u64 off0,
    .param .u64 off1,
    .param .u64 n,
    .param .u64 out_ptr
)
{
    .reg .pred %p;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %c0;
    .reg .u32 %c1;
    .reg .u64 %rp;
    .reg .u64 %b0;
    .reg .u64 %b1;
    .reg .u64 %n;
    .reg .u64 %out;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o;
    .reg .u64 %addr;
    .reg .u64 %k;
    .reg .u64 %tmp;

    ld.param.u64 %rp, [resident_ptr];
    ld.param.u64 %o, [off0];
    add.u64 %b0, %rp, %o;
    ld.param.u64 %o, [off1];
    add.u64 %b1, %rp, %o;
    ld.param.u64 %n, [n];
    ld.param.u64 %out, [out_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_pack2:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_pack2;
    mul.lo.u64 %o, %i, 4;
    add.u64 %addr, %b0, %o;
    ld.global.u32 %c0, [%addr];
    add.u64 %addr, %b1, %o;
    ld.global.u32 %c1, [%addr];
    cvt.u64.u32 %k, %c0;
    shl.b64 %k, %k, 32;
    cvt.u64.u32 %tmp, %c1;
    or.b64 %k, %k, %tmp;
    mul.lo.u64 %o, %i, 8;
    add.u64 %addr, %out, %o;
    st.global.u64 [%addr], %k;
    add.u64 %i, %i, %stride;
    bra loop_pack2;
done_pack2:
    ret;
}

// COUNT(DISTINCT v) mark pass: inputs are the (g, v) i64 tuple matrix (row-major, 2 keys/row =
// 16 bytes/row) already sorted by (g, v) via `perm`, plus that permutation. For each sorted
// position i, emit g_sorted[i] = g[perm[i]] (the group key) and new_distinct[i] = 1 iff the (g, v)
// tuple differs from the previous sorted tuple (i == 0 is always new). A pure MAP -- no atomics, no
// hash -- so it cannot reintroduce the bool-GROUP-BY concurrency hazard. SUM(new_distinct) grouped
// by g_sorted = the per-group distinct count. Buffers are leased (>=8-aligned) so i64 ld/st are safe.
.visible .entry gpu_db_mark_new_distinct(
    .param .u64 keys_ptr,
    .param .u64 perm_ptr,
    .param .u64 n,
    .param .u64 g_out,
    .param .u64 nd_out
)
{
    .reg .pred %p;
    .reg .pred %q;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %row;
    .reg .u32 %prow;
    .reg .u64 %keys;
    .reg .u64 %perm;
    .reg .u64 %n;
    .reg .u64 %gout;
    .reg .u64 %ndout;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %o;
    .reg .u64 %addr;
    .reg .u64 %base;
    .reg .u64 %pbase;
    .reg .u64 %g;
    .reg .u64 %v;
    .reg .u64 %pg;
    .reg .u64 %pv;
    .reg .u64 %nd;
    .reg .u64 %r64;

    ld.param.u64 %keys, [keys_ptr];
    ld.param.u64 %perm, [perm_ptr];
    ld.param.u64 %n, [n];
    ld.param.u64 %gout, [g_out];
    ld.param.u64 %ndout, [nd_out];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_mark_nd:
    setp.ge.u64 %p, %i, %n;
    @%p bra done_mark_nd;
    mul.lo.u64 %o, %i, 4;
    add.u64 %addr, %perm, %o;
    ld.global.u32 %row, [%addr];
    cvt.u64.u32 %r64, %row;
    mul.lo.u64 %o, %r64, 16;
    add.u64 %base, %keys, %o;
    ld.global.u64 %g, [%base];
    ld.global.u64 %v, [%base+8];
    mul.lo.u64 %o, %i, 8;
    add.u64 %addr, %gout, %o;
    st.global.u64 [%addr], %g;
    setp.eq.u64 %p, %i, 0;
    @%p bra mark_is_new;
    sub.u64 %o, %i, 1;
    mul.lo.u64 %o, %o, 4;
    add.u64 %addr, %perm, %o;
    ld.global.u32 %prow, [%addr];
    cvt.u64.u32 %r64, %prow;
    mul.lo.u64 %o, %r64, 16;
    add.u64 %pbase, %keys, %o;
    ld.global.u64 %pg, [%pbase];
    ld.global.u64 %pv, [%pbase+8];
    setp.ne.u64 %p, %g, %pg;
    setp.ne.u64 %q, %v, %pv;
    or.pred %p, %p, %q;
    @%p bra mark_is_new;
    mov.u64 %nd, 0;
    bra mark_store;
mark_is_new:
    mov.u64 %nd, 1;
mark_store:
    mul.lo.u64 %o, %i, 8;
    add.u64 %addr, %ndout, %o;
    st.global.u64 [%addr], %nd;
    add.u64 %i, %i, %stride;
    bra loop_mark_nd;
done_mark_nd:
    ret;
}

// out[0] += sum over k<count of the i32 column value at row indices[k], sign-extended to i64 (the
// operator axis, doc 19). `out_ptr` is a single i64 the host initialized to 0; `indices_ptr` is the
// filter's surviving u32 row indices. SUM(int4) over a filtered set -> bigint; the i64 atomic add is
// two's-complement so signed accumulation is correct. (Caller guarantees count >= 1: an empty
// aggregate is NULL, which the engine cannot represent until M3, so it hard-errors before this runs.)
.visible .entry gpu_db_resident_i32_sum_at_indices(
    .param .u64 resident_ptr,
    .param .u64 byte_offset,
    .param .u64 indices_ptr,
    .param .u64 count,
    .param .u64 out_ptr
)
{
    .reg .pred %p;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %idx;
    .reg .s32 %val32;
    .reg .s64 %val64;
    .reg .s64 %sum;
    .reg .u64 %sumbits;
    .reg .u64 %old;
    .reg .u64 %base;
    .reg .u64 %iptr;
    .reg .u64 %optr;
    .reg .u64 %count;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %ioff;
    .reg .u64 %iaddr;
    .reg .u64 %voff;
    .reg .u64 %vaddr;

    ld.param.u64 %base, [resident_ptr];
    ld.param.u64 %voff, [byte_offset];
    add.u64 %base, %base, %voff;
    ld.param.u64 %iptr, [indices_ptr];
    ld.param.u64 %count, [count];
    ld.param.u64 %optr, [out_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
    mov.s64 %sum, 0;
loop_sumidx:
    setp.ge.u64 %p, %i, %count;
    @%p bra done_sumidx;
    mul.lo.u64 %ioff, %i, 4;
    add.u64 %iaddr, %iptr, %ioff;
    ld.global.u32 %idx, [%iaddr];
    cvt.u64.u32 %voff, %idx;
    mul.lo.u64 %voff, %voff, 4;
    add.u64 %vaddr, %base, %voff;
    ld.global.s32 %val32, [%vaddr];
    cvt.s64.s32 %val64, %val32;
    add.s64 %sum, %sum, %val64;
    add.u64 %i, %i, %stride;
    bra loop_sumidx;
done_sumidx:
    // one atomic per thread (each thread reduced its strided slice locally).
    cvt.u64.s64 %sumbits, %sum;
    atom.global.add.u64 %old, [%optr], %sumbits;
    ret;
}

// out[0] = MIN (op==0) or MAX (op!=0) over k<count of the i32 column value at row indices[k] (the
// operator axis, doc 19). `out` is a single i32 the host initialized to i32::MAX (min) or i32::MIN
// (max); `indices_ptr` is the filter's surviving u32 rows. Each thread reduces its strided slice into
// a signed local, then one predicated atom.min/max.s32. Caller guarantees count >= 1 (an empty
// MIN/MAX is NULL, not representable until M3, so it hard-errors before this runs).
.visible .entry gpu_db_resident_i32_minmax_at_indices(
    .param .u64 resident_ptr,
    .param .u64 byte_offset,
    .param .u64 indices_ptr,
    .param .u64 count,
    .param .u32 op,
    .param .u64 out_ptr
)
{
    .reg .pred %p;
    .reg .pred %is_min;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %opv;
    .reg .u32 %idx;
    .reg .s32 %val32;
    .reg .s32 %acc;
    .reg .s32 %old;
    .reg .u64 %base;
    .reg .u64 %iptr;
    .reg .u64 %optr;
    .reg .u64 %count;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %ioff;
    .reg .u64 %iaddr;
    .reg .u64 %voff;
    .reg .u64 %vaddr;

    ld.param.u64 %base, [resident_ptr];
    ld.param.u64 %voff, [byte_offset];
    add.u64 %base, %base, %voff;
    ld.param.u64 %iptr, [indices_ptr];
    ld.param.u64 %count, [count];
    ld.param.u32 %opv, [op];
    ld.param.u64 %optr, [out_ptr];
    setp.eq.u32 %is_min, %opv, 0;
    mov.s32 %acc, -2147483648;
    @%is_min mov.s32 %acc, 2147483647;
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_mm:
    setp.ge.u64 %p, %i, %count;
    @%p bra done_mm;
    mul.lo.u64 %ioff, %i, 4;
    add.u64 %iaddr, %iptr, %ioff;
    ld.global.u32 %idx, [%iaddr];
    cvt.u64.u32 %voff, %idx;
    mul.lo.u64 %voff, %voff, 4;
    add.u64 %vaddr, %base, %voff;
    ld.global.s32 %val32, [%vaddr];
    @%is_min min.s32 %acc, %acc, %val32;
    @!%is_min max.s32 %acc, %acc, %val32;
    add.u64 %i, %i, %stride;
    bra loop_mm;
done_mm:
    @%is_min atom.global.min.s32 %old, [%optr], %acc;
    @!%is_min atom.global.max.s32 %old, [%optr], %acc;
    ret;
}

// out[0] = MIN (op==0) / MAX (op!=0) over k<count of the INT8 column value at row indices[k] (the
// operator axis, doc 19). `out` is a single i64 host-initialized to i64::MAX (min) / i64::MIN (max).
// The int8 section is 8 bytes/row; the value is read as TWO 4-byte loads (the resident i64 may be
// 4-mod-8 aligned, so a single ld.u64 would fault). Local reduce + one predicated atom.min/max.s64.
// Caller guarantees count >= 1 (empty MIN/MAX is NULL, hard-errored upstream until M3).
.visible .entry gpu_db_resident_i64_minmax_at_indices(
    .param .u64 resident_ptr,
    .param .u64 byte_offset,
    .param .u64 indices_ptr,
    .param .u64 count,
    .param .u32 op,
    .param .u64 out_ptr
)
{
    .reg .pred %p;
    .reg .pred %is_min;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %opv;
    .reg .u32 %idx;
    .reg .b32 %w0;
    .reg .b32 %w1;
    .reg .s64 %val;
    .reg .s64 %acc;
    .reg .s64 %old;
    .reg .u64 %base;
    .reg .u64 %iptr;
    .reg .u64 %optr;
    .reg .u64 %count;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %ioff;
    .reg .u64 %iaddr;
    .reg .u64 %voff;
    .reg .u64 %vaddr;

    ld.param.u64 %base, [resident_ptr];
    ld.param.u64 %voff, [byte_offset];
    add.u64 %base, %base, %voff;
    ld.param.u64 %iptr, [indices_ptr];
    ld.param.u64 %count, [count];
    ld.param.u32 %opv, [op];
    ld.param.u64 %optr, [out_ptr];
    setp.eq.u32 %is_min, %opv, 0;
    mov.s64 %acc, -9223372036854775808;
    @%is_min mov.s64 %acc, 9223372036854775807;
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_mm64:
    setp.ge.u64 %p, %i, %count;
    @%p bra done_mm64;
    mul.lo.u64 %ioff, %i, 4;
    add.u64 %iaddr, %iptr, %ioff;
    ld.global.u32 %idx, [%iaddr];
    cvt.u64.u32 %voff, %idx;
    mul.lo.u64 %voff, %voff, 8;
    add.u64 %vaddr, %base, %voff;
    ld.global.u32 %w0, [%vaddr];
    ld.global.u32 %w1, [%vaddr+4];
    mov.b64 %val, {%w0, %w1};
    @%is_min min.s64 %acc, %acc, %val;
    @!%is_min max.s64 %acc, %acc, %val;
    add.u64 %i, %i, %stride;
    bra loop_mm64;
done_mm64:
    @%is_min atom.global.min.s64 %old, [%optr], %acc;
    @!%is_min atom.global.max.s64 %old, [%optr], %acc;
    ret;
}

// out = a single i128 (two LE u64 limbs: [out]=low, [out+8]=high), host-zeroed. SUM(int8) over the
// filtered set -> i128 (a sum of i64 can exceed i64). Each thread sums its strided slice into a local
// i128 (2-limb, with the i64 value sign-extended), then commits via a TWO-64-bit-ATOMIC carry add:
// atomicAdd the low limb (detect unsigned wrap -> carry), atomicAdd the high limb by (sum_hi + carry).
// i64 values read as 2x4-byte loads (alignment). count >= 1 (empty SUM is NULL, hard-errored upstream).
.visible .entry gpu_db_resident_i64_sum_at_indices_i128(
    .param .u64 resident_ptr,
    .param .u64 byte_offset,
    .param .u64 indices_ptr,
    .param .u64 count,
    .param .u64 out_ptr
)
{
    .reg .pred %p;
    .reg .pred %carry_p;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %idx;
    .reg .b32 %w0;
    .reg .b32 %w1;
    .reg .s64 %val;
    .reg .s64 %vhi_s;
    .reg .u64 %vlo;
    .reg .u64 %vhi;
    .reg .u64 %sum_lo;
    .reg .u64 %sum_hi;
    .reg .u64 %old_lo;
    .reg .u64 %new_lo;
    .reg .u64 %carry;
    .reg .u64 %hi_add;
    .reg .u64 %old_hi;
    .reg .u64 %base;
    .reg .u64 %iptr;
    .reg .u64 %optr;
    .reg .u64 %ohi;
    .reg .u64 %count;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %ioff;
    .reg .u64 %iaddr;
    .reg .u64 %voff;
    .reg .u64 %vaddr;

    ld.param.u64 %base, [resident_ptr];
    ld.param.u64 %voff, [byte_offset];
    add.u64 %base, %base, %voff;
    ld.param.u64 %iptr, [indices_ptr];
    ld.param.u64 %count, [count];
    ld.param.u64 %optr, [out_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
    mov.u64 %sum_lo, 0;
    mov.u64 %sum_hi, 0;
loop_s128:
    setp.ge.u64 %p, %i, %count;
    @%p bra done_s128;
    mul.lo.u64 %ioff, %i, 4;
    add.u64 %iaddr, %iptr, %ioff;
    ld.global.u32 %idx, [%iaddr];
    cvt.u64.u32 %voff, %idx;
    mul.lo.u64 %voff, %voff, 8;
    add.u64 %vaddr, %base, %voff;
    ld.global.u32 %w0, [%vaddr];
    ld.global.u32 %w1, [%vaddr+4];
    mov.b64 %val, {%w0, %w1};
    shr.s64 %vhi_s, %val, 63;
    mov.b64 %vhi, %vhi_s;
    mov.b64 %vlo, %val;
    add.cc.u64 %sum_lo, %sum_lo, %vlo;
    addc.u64 %sum_hi, %sum_hi, %vhi;
    add.u64 %i, %i, %stride;
    bra loop_s128;
done_s128:
    atom.global.add.u64 %old_lo, [%optr], %sum_lo;
    add.u64 %new_lo, %old_lo, %sum_lo;
    setp.lt.u64 %carry_p, %new_lo, %old_lo;
    selp.u64 %carry, 1, 0, %carry_p;
    add.u64 %hi_add, %sum_hi, %carry;
    add.u64 %ohi, %optr, 8;
    atom.global.add.u64 %old_hi, [%ohi], %hi_add;
    ret;
}

// MIN (op==0) / MAX (op!=0) over k<count of the NUMERIC (i128 mantissa) column at row indices[k] (the
// operator axis, doc 19). No native 128-bit atomic min/max, so each thread reduces its strided slice
// into a LOCAL i128 and writes one PARTIAL to partials[global_tid] (16 bytes, lo then hi, LE); the host
// combines the (bounded) partials. i128 read as 4x4-byte loads (alignment); signed compare = signed
// high limb, unsigned low tie-break. Idle threads write the identity (i128::MAX for min / MIN for max),
// which the host combine ignores. NB: %gtid is the global thread id -- a register named %tid would
// shadow the special %tid.x and break ptxas with "Unknown field '.x'".
.visible .entry gpu_db_resident_i128_minmax_partials_at_indices(
    .param .u64 resident_ptr,
    .param .u64 byte_offset,
    .param .u64 indices_ptr,
    .param .u64 count,
    .param .u32 op,
    .param .u64 partials_ptr
)
{
    .reg .pred %p;
    .reg .pred %is_min;
    .reg .pred %not_min;
    .reg .pred %hi_lt;
    .reg .pred %hi_gt;
    .reg .pred %hi_eq;
    .reg .pred %lo_lt;
    .reg .pred %lo_gt;
    .reg .pred %col_lt;
    .reg .pred %col_gt;
    .reg .pred %take;
    .reg .pred %tmp;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %opv;
    .reg .u32 %idx;
    .reg .b32 %w0;
    .reg .b32 %w1;
    .reg .b64 %acc_lo;
    .reg .b64 %acc_hi;
    .reg .b64 %col_lo;
    .reg .b64 %col_hi;
    .reg .u64 %base;
    .reg .u64 %iptr;
    .reg .u64 %pptr;
    .reg .u64 %count;
    .reg .u64 %gtid;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %ioff;
    .reg .u64 %iaddr;
    .reg .u64 %voff;
    .reg .u64 %vaddr;
    .reg .u64 %po;

    ld.param.u64 %base, [resident_ptr];
    ld.param.u64 %voff, [byte_offset];
    add.u64 %base, %base, %voff;
    ld.param.u64 %iptr, [indices_ptr];
    ld.param.u64 %count, [count];
    ld.param.u32 %opv, [op];
    ld.param.u64 %pptr, [partials_ptr];
    setp.eq.u32 %is_min, %opv, 0;
    not.pred %not_min, %is_min;
    mov.b64 %acc_hi, 0x8000000000000000;
    mov.b64 %acc_lo, 0;
    @%is_min mov.b64 %acc_hi, 0x7fffffffffffffff;
    @%is_min mov.b64 %acc_lo, 0xffffffffffffffff;
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %gtid, %t32;
    mov.u64 %i, %gtid;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_mmp:
    setp.ge.u64 %p, %i, %count;
    @%p bra done_mmp;
    mul.lo.u64 %ioff, %i, 4;
    add.u64 %iaddr, %iptr, %ioff;
    ld.global.u32 %idx, [%iaddr];
    cvt.u64.u32 %voff, %idx;
    mul.lo.u64 %voff, %voff, 16;
    add.u64 %vaddr, %base, %voff;
    ld.global.u32 %w0, [%vaddr];
    ld.global.u32 %w1, [%vaddr+4];
    mov.b64 %col_lo, {%w0, %w1};
    ld.global.u32 %w0, [%vaddr+8];
    ld.global.u32 %w1, [%vaddr+12];
    mov.b64 %col_hi, {%w0, %w1};
    setp.lt.s64 %hi_lt, %col_hi, %acc_hi;
    setp.gt.s64 %hi_gt, %col_hi, %acc_hi;
    setp.eq.s64 %hi_eq, %col_hi, %acc_hi;
    setp.lt.u64 %lo_lt, %col_lo, %acc_lo;
    setp.gt.u64 %lo_gt, %col_lo, %acc_lo;
    and.pred %tmp, %hi_eq, %lo_lt;
    or.pred %col_lt, %hi_lt, %tmp;
    and.pred %tmp, %hi_eq, %lo_gt;
    or.pred %col_gt, %hi_gt, %tmp;
    and.pred %take, %is_min, %col_lt;
    and.pred %tmp, %not_min, %col_gt;
    or.pred %take, %take, %tmp;
    @%take mov.b64 %acc_lo, %col_lo;
    @%take mov.b64 %acc_hi, %col_hi;
    add.u64 %i, %i, %stride;
    bra loop_mmp;
done_mmp:
    mul.lo.u64 %po, %gtid, 16;
    add.u64 %vaddr, %pptr, %po;
    mov.b64 {%w0, %w1}, %acc_lo;
    st.global.u32 [%vaddr], %w0;
    st.global.u32 [%vaddr+4], %w1;
    mov.b64 {%w0, %w1}, %acc_hi;
    st.global.u32 [%vaddr+8], %w0;
    st.global.u32 [%vaddr+12], %w1;
    ret;
}

// SUM over k<count of the NUMERIC (i128 mantissa) column at row indices[k] (the operator axis, doc
// 19), as a partials reduction with CHECKED i128 overflow. Each thread sums its strided slice into a
// local i128 (2-limb add.cc/addc) and writes one PARTIAL to partials[global_tid]; the host
// checked-combines the (bounded) partials. If ANY per-thread add overflows i128 (signed: operands
// same sign, result sign flips), the thread sets *overflow_flag (the host then errors -- a wrapped
// partial is unusable). i128 read as 4x4-byte loads (alignment). overflow_flag host-init 0; partials
// host-zeroed is unnecessary (every slot is written). NB: %gtid (not %tid -- shadows %tid.x).
.visible .entry gpu_db_resident_i128_sum_partials_at_indices(
    .param .u64 resident_ptr,
    .param .u64 byte_offset,
    .param .u64 indices_ptr,
    .param .u64 count,
    .param .u64 partials_ptr,
    .param .u64 overflow_flag_ptr
)
{
    .reg .pred %p;
    .reg .pred %same_sign;
    .reg .pred %diff_res;
    .reg .pred %ovf;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %idx;
    .reg .b32 %w0;
    .reg .b32 %w1;
    .reg .b64 %acc_lo;
    .reg .b64 %acc_hi;
    .reg .b64 %col_lo;
    .reg .b64 %col_hi;
    .reg .b64 %res_lo;
    .reg .b64 %res_hi;
    .reg .s64 %as;
    .reg .s64 %bs;
    .reg .s64 %rs;
    .reg .u64 %base;
    .reg .u64 %iptr;
    .reg .u64 %pptr;
    .reg .u64 %fptr;
    .reg .u64 %count;
    .reg .u64 %gtid;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %ioff;
    .reg .u64 %iaddr;
    .reg .u64 %voff;
    .reg .u64 %vaddr;
    .reg .u64 %po;

    ld.param.u64 %base, [resident_ptr];
    ld.param.u64 %voff, [byte_offset];
    add.u64 %base, %base, %voff;
    ld.param.u64 %iptr, [indices_ptr];
    ld.param.u64 %count, [count];
    ld.param.u64 %pptr, [partials_ptr];
    ld.param.u64 %fptr, [overflow_flag_ptr];
    mov.b64 %acc_lo, 0;
    mov.b64 %acc_hi, 0;
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %gtid, %t32;
    mov.u64 %i, %gtid;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
loop_smp:
    setp.ge.u64 %p, %i, %count;
    @%p bra done_smp;
    mul.lo.u64 %ioff, %i, 4;
    add.u64 %iaddr, %iptr, %ioff;
    ld.global.u32 %idx, [%iaddr];
    cvt.u64.u32 %voff, %idx;
    mul.lo.u64 %voff, %voff, 16;
    add.u64 %vaddr, %base, %voff;
    ld.global.u32 %w0, [%vaddr];
    ld.global.u32 %w1, [%vaddr+4];
    mov.b64 %col_lo, {%w0, %w1};
    ld.global.u32 %w0, [%vaddr+8];
    ld.global.u32 %w1, [%vaddr+12];
    mov.b64 %col_hi, {%w0, %w1};
    add.cc.u64 %res_lo, %acc_lo, %col_lo;
    addc.u64 %res_hi, %acc_hi, %col_hi;
    shr.s64 %as, %acc_hi, 63;
    shr.s64 %bs, %col_hi, 63;
    shr.s64 %rs, %res_hi, 63;
    setp.eq.s64 %same_sign, %as, %bs;
    setp.ne.s64 %diff_res, %rs, %as;
    and.pred %ovf, %same_sign, %diff_res;
    @%ovf red.global.or.b32 [%fptr], 1;
    mov.b64 %acc_lo, %res_lo;
    mov.b64 %acc_hi, %res_hi;
    add.u64 %i, %i, %stride;
    bra loop_smp;
done_smp:
    mul.lo.u64 %po, %gtid, 16;
    add.u64 %vaddr, %pptr, %po;
    mov.b64 {%w0, %w1}, %acc_lo;
    st.global.u32 [%vaddr], %w0;
    st.global.u32 [%vaddr+4], %w1;
    mov.b64 {%w0, %w1}, %acc_hi;
    st.global.u32 [%vaddr+8], %w0;
    st.global.u32 [%vaddr+12], %w1;
    ret;
}

// Fill an 8-byte-element array ptr[0..n] with a 64-bit value (grid-stride). Used to initialize a
// GROUP BY hash table's slot_keys to EMPTY (i64::MIN) -- no cuMemset pattern produces a clean i64
// sentinel outside the i32 key range. The buffer is freshly allocated (>=8-aligned), so st.u64 is OK.
.visible .entry gpu_db_fill_i64(
    .param .u64 ptr,
    .param .u64 n,
    .param .u64 value
)
{
    .reg .pred %p;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u64 %base;
    .reg .u64 %n;
    .reg .u64 %val;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %off;
    .reg .u64 %addr;

    ld.param.u64 %base, [ptr];
    ld.param.u64 %n, [n];
    ld.param.u64 %val, [value];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
fill_loop:
    setp.ge.u64 %p, %i, %n;
    @%p bra fill_done;
    mul.lo.u64 %off, %i, 8;
    add.u64 %addr, %base, %off;
    st.global.u64 [%addr], %val;
    add.u64 %i, %i, %stride;
    bra fill_loop;
fill_done:
    ret;
}

// Fill a [b128; n] array with the 128-bit value (vhi:vlo) -- used to init slot_keys_i128 to EMPTY128
// (i128::MIN = vlo=0, vhi=i64::MIN), since that bit pattern is not a uniform-byte memset.
.visible .entry gpu_db_fill_i128(
    .param .u64 ptr,
    .param .u64 n,
    .param .u64 vlo,
    .param .u64 vhi
)
{
    .reg .pred %p;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u64 %base;
    .reg .u64 %n;
    .reg .u64 %vlo;
    .reg .u64 %vhi;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %off;
    .reg .u64 %addr;
    .reg .b128 %v128;

    ld.param.u64 %base, [ptr];
    ld.param.u64 %n, [n];
    ld.param.u64 %vlo, [vlo];
    ld.param.u64 %vhi, [vhi];
    mov.b128 %v128, {%vlo, %vhi};
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
fill128_loop:
    setp.ge.u64 %p, %i, %n;
    @%p bra fill128_done;
    mul.lo.u64 %off, %i, 16;
    add.u64 %addr, %base, %off;
    st.global.b128 [%addr], %v128;
    add.u64 %i, %i, %stride;
    bra fill128_loop;
fill128_done:
    ret;
}

// One bitonic compare-exchange pass over a permutation perm[0..npot) keyed by keys[0..n) (positions
// >= n are PADDING that always sorts last). Pair l = i XOR jj; only the lower index i<l acts.
// seq_asc = ((i & kk) == 0). a_after_b = "row a sorts after row b" (padding last; signed i64; flipped
// by `descending`). SWAP perm[i],perm[l] iff a_after_b == seq_asc. Race-free: each pass partitions
// [0,npot) into disjoint (i,l) pairs. The host loops kk=2..npot, jj=kk/2..1, launching this each pass.
.visible .entry gpu_db_bitonic_sort_i64_step(
    .param .u64 perm_ptr,
    .param .u64 keys_ptr,
    .param .u64 n,
    .param .u64 npot,
    .param .u64 kk,
    .param .u64 jj,
    .param .u64 descending
)
{
    .reg .pred %p;
    .reg .pred %pseq;
    .reg .pred %pafter;
    .reg .pred %pap;
    .reg .pred %pbp;
    .reg .pred %pdesc;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %a32;
    .reg .u32 %b32;
    .reg .u64 %permp;
    .reg .u64 %keysp;
    .reg .u64 %n;
    .reg .u64 %npot;
    .reg .u64 %kk;
    .reg .u64 %jj;
    .reg .u64 %desc;
    .reg .u64 %i;
    .reg .u64 %l;
    .reg .u64 %au;
    .reg .u64 %bu;
    .reg .u64 %off;
    .reg .u64 %addr;
    .reg .u64 %stride;
    .reg .s64 %ka;
    .reg .s64 %kb;

    ld.param.u64 %permp, [perm_ptr];
    ld.param.u64 %keysp, [keys_ptr];
    ld.param.u64 %n, [n];
    ld.param.u64 %npot, [npot];
    ld.param.u64 %kk, [kk];
    ld.param.u64 %jj, [jj];
    ld.param.u64 %desc, [descending];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
    setp.ne.u64 %pdesc, %desc, 0;
bit_loop:
    setp.ge.u64 %p, %i, %npot;
    @%p bra bit_done;
    xor.b64 %l, %i, %jj;
    setp.le.u64 %p, %l, %i;
    @%p bra bit_next;
    mul.lo.u64 %off, %i, 4;
    add.u64 %addr, %permp, %off;
    ld.global.u32 %a32, [%addr];
    mul.lo.u64 %off, %l, 4;
    add.u64 %addr, %permp, %off;
    ld.global.u32 %b32, [%addr];
    cvt.u64.u32 %au, %a32;
    cvt.u64.u32 %bu, %b32;
    and.b64 %off, %i, %kk;
    setp.eq.u64 %pseq, %off, 0;
    setp.ge.u64 %pap, %au, %n;
    setp.ge.u64 %pbp, %bu, %n;
    @%pap bra bit_apad;
    @%pbp bra bit_afalse;
    mul.lo.u64 %off, %au, 8;
    add.u64 %addr, %keysp, %off;
    ld.global.s64 %ka, [%addr];
    mul.lo.u64 %off, %bu, 8;
    add.u64 %addr, %keysp, %off;
    ld.global.s64 %kb, [%addr];
    @%pdesc bra bit_adesc;
    setp.gt.s64 %pafter, %ka, %kb;
    bra bit_adone;
bit_adesc:
    setp.lt.s64 %pafter, %ka, %kb;
    bra bit_adone;
bit_apad:
    @%pbp bra bit_afalse;
    setp.eq.u64 %pafter, %n, %n;
    bra bit_adone;
bit_afalse:
    setp.ne.u64 %pafter, %n, %n;
bit_adone:
    xor.pred %p, %pafter, %pseq;
    @%p bra bit_next;
    mul.lo.u64 %off, %i, 4;
    add.u64 %addr, %permp, %off;
    st.global.u32 [%addr], %b32;
    mul.lo.u64 %off, %l, 4;
    add.u64 %addr, %permp, %off;
    st.global.u32 [%addr], %a32;
bit_next:
    add.u64 %i, %i, %stride;
    bra bit_loop;
bit_done:
    ret;
}

// Bitonic compare-exchange pass keyed by a resident TEXT column (lexicographic, UNSIGNED bytes, a
// prefix sorts SMALLER). `perm` is the permutation over [0,npot); for a position pos<n, the row id is
// `indices[pos]` and its text = bytes[offsets[row] .. offsets[row+1]]. Offsets are read as 2x ld.u32
// (the section can land 4-mod-8 aligned, where an 8-byte load faults 716). Padding (perm value >= n)
// sorts last by POSITION (never a key sentinel) so DESC is safe. Mirrors gpu_db_bitonic_sort_i64_step;
// only the "both real" comparator differs (a byte-wise compare instead of an s64 compare).
.visible .entry gpu_db_bitonic_sort_text_step(
    .param .u64 perm_ptr,
    .param .u64 indices_ptr,
    .param .u64 offsets_base_ptr,
    .param .u64 bytes_base_ptr,
    .param .u64 n,
    .param .u64 npot,
    .param .u64 kk,
    .param .u64 jj,
    .param .u64 descending
)
{
    .reg .pred %p;
    .reg .pred %pseq;
    .reg .pred %pafter;
    .reg .pred %pap;
    .reg .pred %pbp;
    .reg .pred %pdesc;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %w0;
    .reg .u32 %w1;
    .reg .u32 %abyte;
    .reg .u32 %bbyte;
    .reg .u32 %a32;
    .reg .u32 %b32;
    .reg .u64 %permp;
    .reg .u64 %indp;
    .reg .u64 %offb;
    .reg .u64 %bytb;
    .reg .u64 %n;
    .reg .u64 %npot;
    .reg .u64 %kk;
    .reg .u64 %jj;
    .reg .u64 %desc;
    .reg .u64 %i;
    .reg .u64 %l;
    .reg .u64 %au;
    .reg .u64 %bu;
    .reg .u64 %off;
    .reg .u64 %addr;
    .reg .u64 %stride;
    .reg .u64 %rowa;
    .reg .u64 %rowb;
    .reg .u64 %o8;
    .reg .u64 %sta;
    .reg .u64 %ena;
    .reg .u64 %stb;
    .reg .u64 %enb;
    .reg .u64 %lena;
    .reg .u64 %lenb;
    .reg .u64 %minlen;
    .reg .u64 %j;
    .reg .u64 %ba;
    .reg .u64 %bb;
    .reg .s64 %cmp;

    ld.param.u64 %permp, [perm_ptr];
    ld.param.u64 %indp, [indices_ptr];
    ld.param.u64 %offb, [offsets_base_ptr];
    ld.param.u64 %bytb, [bytes_base_ptr];
    ld.param.u64 %n, [n];
    ld.param.u64 %npot, [npot];
    ld.param.u64 %kk, [kk];
    ld.param.u64 %jj, [jj];
    ld.param.u64 %desc, [descending];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
    setp.ne.u64 %pdesc, %desc, 0;
txt_loop:
    setp.ge.u64 %p, %i, %npot;
    @%p bra txt_done;
    xor.b64 %l, %i, %jj;
    setp.le.u64 %p, %l, %i;
    @%p bra txt_next;
    mul.lo.u64 %off, %i, 4;
    add.u64 %addr, %permp, %off;
    ld.global.u32 %a32, [%addr];
    mul.lo.u64 %off, %l, 4;
    add.u64 %addr, %permp, %off;
    ld.global.u32 %b32, [%addr];
    cvt.u64.u32 %au, %a32;
    cvt.u64.u32 %bu, %b32;
    and.b64 %off, %i, %kk;
    setp.eq.u64 %pseq, %off, 0;
    setp.ge.u64 %pap, %au, %n;
    setp.ge.u64 %pbp, %bu, %n;
    @%pap bra txt_apad;
    @%pbp bra txt_afalse;
    mul.lo.u64 %off, %au, 8;
    add.u64 %addr, %indp, %off;
    ld.global.u64 %rowa, [%addr];
    mul.lo.u64 %off, %bu, 8;
    add.u64 %addr, %indp, %off;
    ld.global.u64 %rowb, [%addr];
    mul.lo.u64 %o8, %rowa, 8;
    add.u64 %addr, %offb, %o8;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    mov.b64 %sta, {%w0, %w1};
    ld.global.u32 %w0, [%addr+8];
    ld.global.u32 %w1, [%addr+12];
    mov.b64 %ena, {%w0, %w1};
    sub.u64 %lena, %ena, %sta;
    mul.lo.u64 %o8, %rowb, 8;
    add.u64 %addr, %offb, %o8;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    mov.b64 %stb, {%w0, %w1};
    ld.global.u32 %w0, [%addr+8];
    ld.global.u32 %w1, [%addr+12];
    mov.b64 %enb, {%w0, %w1};
    sub.u64 %lenb, %enb, %stb;
    min.u64 %minlen, %lena, %lenb;
    add.u64 %ba, %bytb, %sta;
    add.u64 %bb, %bytb, %stb;
    mov.u64 %j, 0;
txt_byte:
    setp.ge.u64 %p, %j, %minlen;
    @%p bra txt_eqlen;
    add.u64 %addr, %ba, %j;
    ld.global.u8 %abyte, [%addr];
    add.u64 %addr, %bb, %j;
    ld.global.u8 %bbyte, [%addr];
    setp.eq.u32 %p, %abyte, %bbyte;
    @%p bra txt_byte_next;
    setp.gt.u32 %p, %abyte, %bbyte;
    selp.s64 %cmp, 1, -1, %p;
    bra txt_cmpdone;
txt_byte_next:
    add.u64 %j, %j, 1;
    bra txt_byte;
txt_eqlen:
    setp.gt.u64 %p, %lena, %lenb;
    selp.s64 %cmp, 1, -1, %p;
    setp.eq.u64 %p, %lena, %lenb;
    selp.s64 %cmp, 0, %cmp, %p;
txt_cmpdone:
    @%pdesc bra txt_desc;
    setp.gt.s64 %pafter, %cmp, 0;
    bra txt_adone;
txt_desc:
    setp.lt.s64 %pafter, %cmp, 0;
    bra txt_adone;
txt_apad:
    @%pbp bra txt_afalse;
    setp.eq.u64 %pafter, %n, %n;
    bra txt_adone;
txt_afalse:
    setp.ne.u64 %pafter, %n, %n;
txt_adone:
    xor.pred %p, %pafter, %pseq;
    @%p bra txt_next;
    mul.lo.u64 %off, %i, 4;
    add.u64 %addr, %permp, %off;
    st.global.u32 [%addr], %b32;
    mul.lo.u64 %off, %l, 4;
    add.u64 %addr, %permp, %off;
    st.global.u32 [%addr], %a32;
txt_next:
    add.u64 %i, %i, %stride;
    bra txt_loop;
txt_done:
    ret;
}

// Multi-key variant of gpu_db_bitonic_sort_i64_step. `keys` is a row-major K-wide matrix of s64:
// keys[row*K + k], key 0 most significant. `desc_mask` bit k set => key k sorts DESCENDING. The
// comparator walks keys 0..K; the FIRST non-equal key decides the order (asc: a_after_b iff ka>kb;
// desc: iff ka<kb) and stops; if all K keys are equal a_after_b is false (a stable no-swap). Padding
// (a perm entry >= n) sorts last, identical to the single-key kernel -- the sentinel is the POSITION
// (>= n), never a key value, so DESC keys are safe. One bitonic compare-exchange pass; the host drives
// the kk/jj schedule. Each thread owns positions [i, i+stride, ...) of perm[0..npot).
.visible .entry gpu_db_bitonic_sort_multikey_step(
    .param .u64 perm_ptr,
    .param .u64 keys_ptr,
    .param .u64 n,
    .param .u64 npot,
    .param .u64 kdim,
    .param .u64 kk,
    .param .u64 jj,
    .param .u64 desc_mask
)
{
    .reg .pred %p;
    .reg .pred %pseq;
    .reg .pred %pafter;
    .reg .pred %pap;
    .reg .pred %pbp;
    .reg .pred %pdesc;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %a32;
    .reg .u32 %b32;
    .reg .u64 %permp;
    .reg .u64 %keysp;
    .reg .u64 %n;
    .reg .u64 %npot;
    .reg .u64 %kdim;
    .reg .u64 %k8;
    .reg .u64 %kk;
    .reg .u64 %jj;
    .reg .u64 %descmask;
    .reg .u64 %i;
    .reg .u64 %l;
    .reg .u64 %au;
    .reg .u64 %bu;
    .reg .u64 %off;
    .reg .u64 %addr;
    .reg .u64 %stride;
    .reg .u64 %basea;
    .reg .u64 %baseb;
    .reg .u64 %kidx;
    .reg .u64 %maskbit;
    .reg .u64 %tmp;
    .reg .s64 %ka;
    .reg .s64 %kb;

    ld.param.u64 %permp, [perm_ptr];
    ld.param.u64 %keysp, [keys_ptr];
    ld.param.u64 %n, [n];
    ld.param.u64 %npot, [npot];
    ld.param.u64 %kdim, [kdim];
    ld.param.u64 %kk, [kk];
    ld.param.u64 %jj, [jj];
    ld.param.u64 %descmask, [desc_mask];
    mul.lo.u64 %k8, %kdim, 8;
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
mk_loop:
    setp.ge.u64 %p, %i, %npot;
    @%p bra mk_done;
    xor.b64 %l, %i, %jj;
    setp.le.u64 %p, %l, %i;
    @%p bra mk_next;
    mul.lo.u64 %off, %i, 4;
    add.u64 %addr, %permp, %off;
    ld.global.u32 %a32, [%addr];
    mul.lo.u64 %off, %l, 4;
    add.u64 %addr, %permp, %off;
    ld.global.u32 %b32, [%addr];
    cvt.u64.u32 %au, %a32;
    cvt.u64.u32 %bu, %b32;
    and.b64 %off, %i, %kk;
    setp.eq.u64 %pseq, %off, 0;
    setp.ge.u64 %pap, %au, %n;
    setp.ge.u64 %pbp, %bu, %n;
    @%pap bra mk_apad;
    @%pbp bra mk_afalse;
    mul.lo.u64 %basea, %au, %k8;
    add.u64 %basea, %keysp, %basea;
    mul.lo.u64 %baseb, %bu, %k8;
    add.u64 %baseb, %keysp, %baseb;
    mov.u64 %kidx, 0;
    mov.u64 %maskbit, 1;
mk_key_loop:
    setp.ge.u64 %p, %kidx, %kdim;
    @%p bra mk_alleq;
    mul.lo.u64 %off, %kidx, 8;
    add.u64 %addr, %basea, %off;
    ld.global.s64 %ka, [%addr];
    add.u64 %addr, %baseb, %off;
    ld.global.s64 %kb, [%addr];
    setp.eq.s64 %p, %ka, %kb;
    @%p bra mk_key_next;
    and.b64 %tmp, %descmask, %maskbit;
    setp.ne.u64 %pdesc, %tmp, 0;
    @%pdesc bra mk_kdesc;
    setp.gt.s64 %pafter, %ka, %kb;
    bra mk_adone;
mk_kdesc:
    setp.lt.s64 %pafter, %ka, %kb;
    bra mk_adone;
mk_key_next:
    add.u64 %kidx, %kidx, 1;
    shl.b64 %maskbit, %maskbit, 1;
    bra mk_key_loop;
mk_alleq:
    setp.ne.u64 %pafter, %n, %n;
    bra mk_adone;
mk_apad:
    @%pbp bra mk_afalse;
    setp.eq.u64 %pafter, %n, %n;
    bra mk_adone;
mk_afalse:
    setp.ne.u64 %pafter, %n, %n;
mk_adone:
    xor.pred %p, %pafter, %pseq;
    @%p bra mk_next;
    mul.lo.u64 %off, %i, 4;
    add.u64 %addr, %permp, %off;
    st.global.u32 [%addr], %b32;
    mul.lo.u64 %off, %l, 4;
    add.u64 %addr, %permp, %off;
    st.global.u32 [%addr], %a32;
mk_next:
    add.u64 %i, %i, %stride;
    bra mk_loop;
mk_done:
    ret;
}

// Heterogeneous multi-key bitonic compare-exchange: a key tuple MIXING int and text keys. key_plan[k]
// has bit31=is_text, bits0..30=idx (into the int_keys columns if int, into text_offs/text_bytes if
// text). INT keys are a row-major n*num_int s64 matrix BY POSITION (int_keys[pos*num_int + idx]); TEXT
// keys read the resident column at row indices[pos] (offsets base = resident_base + text_offs[idx],
// bytes base = resident_base + text_bytes[idx]). Comparator walks keys 0..num_keys; first non-equal key
// decides (desc_mask bit k => DESC) and stops; all-equal => no swap. Padding (perm value >= n) sorts
// last by POSITION (never a key sentinel) so DESC is safe. Reuses the s64 compare (multikey) + the
// byte compare (text). Offsets read as 2x ld.u32 (716-safe). One pass; host drives the kk/jj schedule.
.visible .entry gpu_db_bitonic_sort_hetero_step(
    .param .u64 perm_ptr,
    .param .u64 indices_ptr,
    .param .u64 int_keys_ptr,
    .param .u64 num_int,
    .param .u64 text_offs_ptr,
    .param .u64 text_bytes_ptr,
    .param .u64 resident_base_ptr,
    .param .u64 key_plan_ptr,
    .param .u64 num_keys,
    .param .u64 desc_mask,
    .param .u64 n,
    .param .u64 npot,
    .param .u64 kk,
    .param .u64 jj,
    .param .u64 b128_offs_ptr
)
{
    .reg .pred %p;
    .reg .pred %pseq;
    .reg .pred %pafter;
    .reg .pred %pap;
    .reg .pred %pbp;
    .reg .pred %pdesc;
    .reg .pred %ptext;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %w0;
    .reg .u32 %w1;
    .reg .u32 %abyte;
    .reg .u32 %bbyte;
    .reg .u32 %a32;
    .reg .u32 %b32;
    .reg .u32 %plan;
    .reg .u64 %permp;
    .reg .u64 %indp;
    .reg .u64 %intp;
    .reg .u64 %numint;
    .reg .u64 %toffp;
    .reg .u64 %tbytp;
    .reg .u64 %resb;
    .reg .u64 %b128p;
    .reg .u64 %colbase;
    .reg .u64 %planp;
    .reg .u64 %numkeys;
    .reg .u64 %descmask;
    .reg .u64 %n;
    .reg .u64 %npot;
    .reg .u64 %kk;
    .reg .u64 %jj;
    .reg .u64 %i;
    .reg .u64 %l;
    .reg .u64 %au;
    .reg .u64 %bu;
    .reg .u64 %off;
    .reg .u64 %addr;
    .reg .u64 %stride;
    .reg .u64 %rowa;
    .reg .u64 %rowb;
    .reg .u64 %kidx;
    .reg .u64 %maskbit;
    .reg .u64 %tmp;
    .reg .u64 %idx;
    .reg .u64 %offb;
    .reg .u64 %bytb;
    .reg .u64 %o8;
    .reg .u64 %sta;
    .reg .u64 %ena;
    .reg .u64 %stb;
    .reg .u64 %enb;
    .reg .u64 %lena;
    .reg .u64 %lenb;
    .reg .u64 %minlen;
    .reg .u64 %j;
    .reg .u64 %ba;
    .reg .u64 %bb;
    .reg .s64 %ka;
    .reg .s64 %kb;
    .reg .s64 %cmp;

    ld.param.u64 %permp, [perm_ptr];
    ld.param.u64 %indp, [indices_ptr];
    ld.param.u64 %intp, [int_keys_ptr];
    ld.param.u64 %numint, [num_int];
    ld.param.u64 %toffp, [text_offs_ptr];
    ld.param.u64 %tbytp, [text_bytes_ptr];
    ld.param.u64 %resb, [resident_base_ptr];
    ld.param.u64 %planp, [key_plan_ptr];
    ld.param.u64 %numkeys, [num_keys];
    ld.param.u64 %descmask, [desc_mask];
    ld.param.u64 %n, [n];
    ld.param.u64 %npot, [npot];
    ld.param.u64 %kk, [kk];
    ld.param.u64 %jj, [jj];
    ld.param.u64 %b128p, [b128_offs_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
het_loop:
    setp.ge.u64 %p, %i, %npot;
    @%p bra het_done;
    xor.b64 %l, %i, %jj;
    setp.le.u64 %p, %l, %i;
    @%p bra het_next;
    mul.lo.u64 %off, %i, 4;
    add.u64 %addr, %permp, %off;
    ld.global.u32 %a32, [%addr];
    mul.lo.u64 %off, %l, 4;
    add.u64 %addr, %permp, %off;
    ld.global.u32 %b32, [%addr];
    cvt.u64.u32 %au, %a32;
    cvt.u64.u32 %bu, %b32;
    and.b64 %off, %i, %kk;
    setp.eq.u64 %pseq, %off, 0;
    setp.ge.u64 %pap, %au, %n;
    setp.ge.u64 %pbp, %bu, %n;
    @%pap bra het_apad;
    @%pbp bra het_afalse;
    mul.lo.u64 %off, %au, 8;
    add.u64 %addr, %indp, %off;
    ld.global.u64 %rowa, [%addr];
    mul.lo.u64 %off, %bu, 8;
    add.u64 %addr, %indp, %off;
    ld.global.u64 %rowb, [%addr];
    mov.u64 %kidx, 0;
    mov.u64 %maskbit, 1;
het_key_loop:
    setp.ge.u64 %p, %kidx, %numkeys;
    @%p bra het_alleq;
    mul.lo.u64 %off, %kidx, 4;
    add.u64 %addr, %planp, %off;
    ld.global.u32 %plan, [%addr];
    shr.u32 %t32, %plan, 30;
    and.b32 %w0, %plan, 1073741823;
    cvt.u64.u32 %idx, %w0;
    setp.eq.u32 %p, %t32, 1;
    @%p bra het_textcmp;
    setp.eq.u32 %p, %t32, 2;
    @%p bra het_numcmp;
    setp.eq.u32 %p, %t32, 3;
    @%p bra het_uuidcmp;
    mul.lo.u64 %tmp, %au, %numint;
    add.u64 %tmp, %tmp, %idx;
    mul.lo.u64 %tmp, %tmp, 8;
    add.u64 %addr, %intp, %tmp;
    ld.global.s64 %ka, [%addr];
    mul.lo.u64 %tmp, %bu, %numint;
    add.u64 %tmp, %tmp, %idx;
    mul.lo.u64 %tmp, %tmp, 8;
    add.u64 %addr, %intp, %tmp;
    ld.global.s64 %kb, [%addr];
    setp.lt.s64 %p, %ka, %kb;
    selp.s64 %cmp, -1, 0, %p;
    setp.gt.s64 %p, %ka, %kb;
    selp.s64 %cmp, 1, %cmp, %p;
    bra het_havecmp;
het_numcmp:
    mul.lo.u64 %off, %idx, 8;
    add.u64 %addr, %b128p, %off;
    ld.global.u64 %tmp, [%addr];
    add.u64 %colbase, %resb, %tmp;
    mul.lo.u64 %o8, %rowa, 16;
    add.u64 %addr, %colbase, %o8;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    mov.b64 %sta, {%w0, %w1};
    ld.global.u32 %w0, [%addr+8];
    ld.global.u32 %w1, [%addr+12];
    mov.b64 %ena, {%w0, %w1};
    mul.lo.u64 %o8, %rowb, 16;
    add.u64 %addr, %colbase, %o8;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    mov.b64 %stb, {%w0, %w1};
    ld.global.u32 %w0, [%addr+8];
    ld.global.u32 %w1, [%addr+12];
    mov.b64 %enb, {%w0, %w1};
    setp.lt.s64 %p, %ena, %enb;
    selp.s64 %cmp, -1, 0, %p;
    setp.gt.s64 %p, %ena, %enb;
    selp.s64 %cmp, 1, %cmp, %p;
    setp.eq.s64 %p, %ena, %enb;
    @!%p bra het_havecmp;
    setp.lt.u64 %p, %sta, %stb;
    selp.s64 %cmp, -1, 0, %p;
    setp.gt.u64 %p, %sta, %stb;
    selp.s64 %cmp, 1, %cmp, %p;
    bra het_havecmp;
het_uuidcmp:
    mul.lo.u64 %off, %idx, 8;
    add.u64 %addr, %b128p, %off;
    ld.global.u64 %tmp, [%addr];
    add.u64 %colbase, %resb, %tmp;
    mul.lo.u64 %o8, %rowa, 16;
    add.u64 %ba, %colbase, %o8;
    mul.lo.u64 %o8, %rowb, 16;
    add.u64 %bb, %colbase, %o8;
    mov.u64 %j, 0;
    mov.s64 %cmp, 0;
het_uuid_byte:
    setp.ge.u64 %p, %j, 16;
    @%p bra het_havecmp;
    add.u64 %addr, %ba, %j;
    ld.global.u8 %abyte, [%addr];
    add.u64 %addr, %bb, %j;
    ld.global.u8 %bbyte, [%addr];
    setp.eq.u32 %p, %abyte, %bbyte;
    @%p bra het_uuid_byte_next;
    setp.gt.u32 %p, %abyte, %bbyte;
    selp.s64 %cmp, 1, -1, %p;
    bra het_havecmp;
het_uuid_byte_next:
    add.u64 %j, %j, 1;
    bra het_uuid_byte;
het_textcmp:
    mul.lo.u64 %off, %idx, 8;
    add.u64 %addr, %toffp, %off;
    ld.global.u64 %tmp, [%addr];
    add.u64 %offb, %resb, %tmp;
    add.u64 %addr, %tbytp, %off;
    ld.global.u64 %tmp, [%addr];
    add.u64 %bytb, %resb, %tmp;
    mul.lo.u64 %o8, %rowa, 8;
    add.u64 %addr, %offb, %o8;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    mov.b64 %sta, {%w0, %w1};
    ld.global.u32 %w0, [%addr+8];
    ld.global.u32 %w1, [%addr+12];
    mov.b64 %ena, {%w0, %w1};
    sub.u64 %lena, %ena, %sta;
    mul.lo.u64 %o8, %rowb, 8;
    add.u64 %addr, %offb, %o8;
    ld.global.u32 %w0, [%addr];
    ld.global.u32 %w1, [%addr+4];
    mov.b64 %stb, {%w0, %w1};
    ld.global.u32 %w0, [%addr+8];
    ld.global.u32 %w1, [%addr+12];
    mov.b64 %enb, {%w0, %w1};
    sub.u64 %lenb, %enb, %stb;
    min.u64 %minlen, %lena, %lenb;
    add.u64 %ba, %bytb, %sta;
    add.u64 %bb, %bytb, %stb;
    mov.u64 %j, 0;
het_byte:
    setp.ge.u64 %p, %j, %minlen;
    @%p bra het_eqlen;
    add.u64 %addr, %ba, %j;
    ld.global.u8 %abyte, [%addr];
    add.u64 %addr, %bb, %j;
    ld.global.u8 %bbyte, [%addr];
    setp.eq.u32 %p, %abyte, %bbyte;
    @%p bra het_byte_next;
    setp.gt.u32 %p, %abyte, %bbyte;
    selp.s64 %cmp, 1, -1, %p;
    bra het_havecmp;
het_byte_next:
    add.u64 %j, %j, 1;
    bra het_byte;
het_eqlen:
    setp.gt.u64 %p, %lena, %lenb;
    selp.s64 %cmp, 1, -1, %p;
    setp.eq.u64 %p, %lena, %lenb;
    selp.s64 %cmp, 0, %cmp, %p;
het_havecmp:
    setp.eq.s64 %p, %cmp, 0;
    @%p bra het_key_next;
    and.b64 %tmp, %descmask, %maskbit;
    setp.ne.u64 %pdesc, %tmp, 0;
    @%pdesc bra het_kdesc;
    setp.gt.s64 %pafter, %cmp, 0;
    bra het_adone;
het_kdesc:
    setp.lt.s64 %pafter, %cmp, 0;
    bra het_adone;
het_key_next:
    add.u64 %kidx, %kidx, 1;
    shl.b64 %maskbit, %maskbit, 1;
    bra het_key_loop;
het_alleq:
    setp.ne.u64 %pafter, %n, %n;
    bra het_adone;
het_apad:
    @%pbp bra het_afalse;
    setp.eq.u64 %pafter, %n, %n;
    bra het_adone;
het_afalse:
    setp.ne.u64 %pafter, %n, %n;
het_adone:
    xor.pred %p, %pafter, %pseq;
    @%p bra het_next;
    mul.lo.u64 %off, %i, 4;
    add.u64 %addr, %permp, %off;
    st.global.u32 [%addr], %b32;
    mul.lo.u64 %off, %l, 4;
    add.u64 %addr, %permp, %off;
    st.global.u32 [%addr], %a32;
het_next:
    add.u64 %i, %i, %stride;
    bra het_loop;
het_done:
    ret;
}

// GROUP BY an int4 key, aggregating COUNT(*) and SUM(int4 value) into an open-addressing hash table
// (the operator axis, doc 19; the general path -- the enumerated GROUP BY is a host BTreeMap).
//   slot_keys : [s64; NSLOTS] host-init to EMPTY (i64::MIN) via gpu_db_fill_i64.
//   slot_count: [u64; NSLOTS] host-init 0.   slot_sum: [s64; NSLOTS] host-init 0.
// NSLOTS is a power of two (mask = NSLOTS-1) sized > distinct keys, so linear probing terminates.
// Each thread r<count reads key/val = the int4 columns at row indices[r], murmur3-64-finalizes the
// key to a slot, linear-probes with atom.cas.b64 to claim/find the group, then atom.add count + sum.
