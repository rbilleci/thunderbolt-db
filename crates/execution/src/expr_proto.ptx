    add.u64 %vaddr, %base, %koffoff;
    add.u64 %vaddr, %vaddr, %o8;
    ld.global.u32 %klo, [%vaddr];
    ld.global.u32 %khi, [%vaddr+4];
    mov.b64 %sstart, {%klo, %khi};
    ld.global.u32 %klo, [%vaddr+8];
    ld.global.u32 %khi, [%vaddr+12];
    mov.b64 %send, {%klo, %khi};
    sub.u64 %slen, %send, %sstart;
    setp.ne.u64 %pf, %slen, %tlen;
    @%pf bra ktext_probe_next;
    add.u64 %babase, %base, %kbytesoff;
    add.u64 %babase, %babase, %sstart;
    mov.u64 %jt, 0;
ktext_vbyte:
    setp.ge.u64 %p, %jt, %tlen;
    @%p bra do_agg;
    add.u64 %aaddr, %taddr, %jt;
    ld.global.u8 %abyte, [%aaddr];
    add.u64 %baddr, %babase, %jt;
    ld.global.u8 %bbyte, [%baddr];
    setp.ne.u32 %p, %abyte, %bbyte;
    @%p bra ktext_probe_next;
    add.u64 %jt, %jt, 1;
    bra ktext_vbyte;
ktext_probe_next:
    add.u64 %h, %h, 1;
    and.b64 %h, %h, %mask;
    bra probe_loop_text;
do_agg:
    mul.lo.u64 %off, %h, 8;
    add.u64 %addr, %cptr, %off;
    atom.global.add.u64 %tmp, [%addr], 1;
    setp.ne.u64 %pvn, %vn, 0;
    @%pvn bra gb_sumnum;
    setp.ne.u64 %p, %v8, 0;
    @%p bra gb_sum8;
    // int4 sum: single i64 atomic add.
    add.u64 %addr, %sptr, %off;
    atom.global.add.u64 %tmp, [%addr], %val;
    bra gb_sumd;
gb_sum8:
    // int8 sum: i128 two-atomic carry (lo into slot_sum, hi into slot_sum_hi). Lock-free: each
    // thread's carry comes from its own low-limb atomicAdd return, so sum(hi)=sum(signext+carry).
    add.u64 %addr, %sptr, %off;
    atom.global.add.u64 %oldlo, [%addr], %val;
    add.u64 %newlo, %oldlo, %val;
    setp.lt.u64 %pc, %newlo, %oldlo;
    selp.s64 %carry, 1, 0, %pc;
    shr.s64 %hi, %val, 63;
    add.s64 %hi, %hi, %carry;
    add.u64 %addr, %shptr, %off;
    atom.global.add.u64 %tmp, [%addr], %hi;
    bra gb_sumd;
gb_sumnum:
    // numeric sum: i128 += i128 (low %val, high %valhi -- the REAL high limb, not a sign-extension),
    // same lock-free carry, plus per-add SIGNED-OVERFLOW detection on the high limb -> set the global
    // overflow flag (PG errors on numeric overflow; we never silently wrap).
    add.u64 %addr, %sptr, %off;
    atom.global.add.u64 %oldlo, [%addr], %val;
    add.u64 %newlo, %oldlo, %val;
    setp.lt.u64 %pc, %newlo, %oldlo;
    selp.s64 %carry, 1, 0, %pc;
    add.s64 %addend, %valhi, %carry;
    add.u64 %addr, %shptr, %off;
    atom.global.add.u64 %oldhi, [%addr], %addend;
    add.s64 %newhi, %oldhi, %addend;
    // overflow iff (oldhi,addend same sign) && (newhi differs): (~(oldhi^addend) & (oldhi^newhi)) < 0
    xor.b64 %t1, %oldhi, %addend;
    xor.b64 %t2, %oldhi, %newhi;
    not.b64 %t1, %t1;
    and.b64 %t1, %t1, %t2;
    setp.lt.s64 %pov, %t1, 0;
    @%pov red.global.or.b32 [%ovptr], 1;
gb_sumd:
    @%pvt bra gb_textminmax;
    @%puu bra gb_uuidminmax;
    @%pvn bra gb_numminmax;
    add.u64 %addr, %mnptr, %off;
    atom.global.min.s64 %cur, [%addr], %val;
    add.u64 %addr, %mxptr, %off;
    atom.global.max.s64 %cur, [%addr], %val;
    bra gb_mmdone;
gb_numminmax:
    // Pass 1 (LOCK-FREE): per-group MIN/MAX of the HIGH limb via signed atomics, and record this
    // row's claimed slot so pass 2 (a second kernel) can resolve the LOW limb among the high-limb
    // ties. (The previous per-slot spin lock deadlocked the GPU under warp contention; this two-pass
    // design uses ONLY lock-free atomics -- no lock, no deadlock.)
    add.u64 %a1, %mnhiptr, %off;
    atom.global.min.s64 %cmhi, [%a1], %valhi;
    add.u64 %a1, %mxhiptr, %off;
    atom.global.max.s64 %cmhi, [%a1], %valhi;
    mul.lo.u64 %loff, %i, 4;
    add.u64 %laddr, %rsptr, %loff;
    cvt.u32.u64 %lockold, %h;
    st.global.u32 [%laddr], %lockold;
    bra gb_mmdone;
gb_uuidminmax:
    // uuid MIN/MAX: lock-free b128 CAS loop (native 128-bit CAS, sm_90+). %val128 = the BE uuid;
    // compare via the two UNSIGNED 64-bit halves (%uhi:%ulo). slot_min_uuid/slot_max_uuid are b128.
    mul.lo.u64 %off16, %h, 16;
    add.u64 %addr, %mnuptr, %off16;
uuid_min_loop:
    ld.global.b128 %cur128, [%addr];
    mov.b128 {%clo, %chi}, %cur128;
    setp.lt.u64 %pa, %uhi, %chi;
    setp.eq.u64 %pb, %uhi, %chi;
    setp.lt.u64 %pc, %ulo, %clo;
    and.pred %pb, %pb, %pc;
    or.pred %pupd, %pa, %pb;
    @!%pupd bra uuid_do_max;
    atom.global.cas.b128 %old128, [%addr], %cur128, %val128;
    mov.b128 {%olo, %ohi}, %old128;
    setp.eq.u64 %pe, %olo, %clo;
    setp.eq.u64 %pf, %ohi, %chi;
    and.pred %pe, %pe, %pf;
    @!%pe bra uuid_min_loop;
uuid_do_max:
    add.u64 %addr, %mxuptr, %off16;
uuid_max_loop:
    ld.global.b128 %cur128, [%addr];
    mov.b128 {%clo, %chi}, %cur128;
    setp.gt.u64 %pa, %uhi, %chi;
    setp.eq.u64 %pb, %uhi, %chi;
    setp.gt.u64 %pc, %ulo, %clo;
    and.pred %pb, %pb, %pc;
    or.pred %pupd, %pa, %pb;
    @!%pupd bra gb_mmdone;
    atom.global.cas.b128 %old128, [%addr], %cur128, %val128;
    mov.b128 {%olo, %ohi}, %old128;
    setp.eq.u64 %pe, %olo, %clo;
    setp.eq.u64 %pf, %ohi, %chi;
    and.pred %pe, %pe, %pf;
    @!%pe bra uuid_max_loop;
    bra gb_mmdone;
gb_textminmax:
    // text MIN/MAX: slot_min/slot_max hold the ROW INDEX of the group's min/max text value (EMPTY =
    // u64::MAX = -1). Lock-free CAS loop on that i64 row index; comparator = lexicographic byte compare
    // of this row's value text (%vstart/%vlen/%vaddr) vs the slot winner's text (re-read each retry).
    cvt.u64.u32 %thisidx, %idx;
    mul.lo.u64 %off, %h, 8;
    add.u64 %addr, %mnptr, %off;
tmin_loop:
    ld.global.u64 %curidx, [%addr];
    setp.eq.u64 %p, %curidx, -1;
    @%p bra tmin_cas;
    mul.lo.u64 %o8, %curidx, 8;
    add.u64 %caddr, %base, %voffoff;
    add.u64 %caddr, %caddr, %o8;
    ld.global.u32 %klo, [%caddr];
    ld.global.u32 %khi, [%caddr+4];
    mov.b64 %cstart, {%klo, %khi};
    ld.global.u32 %klo, [%caddr+8];
    ld.global.u32 %khi, [%caddr+12];
    mov.b64 %cend, {%klo, %khi};
    sub.u64 %clen, %cend, %cstart;
    add.u64 %caddr, %base, %vbytesoff;
    add.u64 %caddr, %caddr, %cstart;
    min.u64 %minlen, %vlen, %clen;
    mov.u64 %jt, 0;
tmin_byte:
    setp.ge.u64 %p, %jt, %minlen;
    @%p bra tmin_lendiff;
    add.u64 %aaddr, %vbaddr, %jt;
    ld.global.u8 %abyte, [%aaddr];
    add.u64 %baddr, %caddr, %jt;
    ld.global.u8 %bbyte, [%baddr];
    setp.lt.u32 %plt, %abyte, %bbyte;
    @%plt bra tmin_cas;
    setp.gt.u32 %pgt, %abyte, %bbyte;
    @%pgt bra tmin_next_max;
    add.u64 %jt, %jt, 1;
    bra tmin_byte;
tmin_lendiff:
    setp.lt.u64 %plt, %vlen, %clen;
    @%plt bra tmin_cas;
    bra tmin_next_max;
tmin_cas:
    atom.global.cas.b64 %oldidx, [%addr], %curidx, %thisidx;
    setp.eq.u64 %p, %oldidx, %curidx;
    @%p bra tmin_next_max;
    bra tmin_loop;
tmin_next_max:
    mul.lo.u64 %off, %h, 8;
    add.u64 %addr, %mxptr, %off;
tmax_loop:
    ld.global.u64 %curidx, [%addr];
    setp.eq.u64 %p, %curidx, -1;
    @%p bra tmax_cas;
    mul.lo.u64 %o8, %curidx, 8;
    add.u64 %caddr, %base, %voffoff;
    add.u64 %caddr, %caddr, %o8;
    ld.global.u32 %klo, [%caddr];
    ld.global.u32 %khi, [%caddr+4];
    mov.b64 %cstart, {%klo, %khi};
    ld.global.u32 %klo, [%caddr+8];
    ld.global.u32 %khi, [%caddr+12];
    mov.b64 %cend, {%klo, %khi};
    sub.u64 %clen, %cend, %cstart;
    add.u64 %caddr, %base, %vbytesoff;
    add.u64 %caddr, %caddr, %cstart;
    min.u64 %minlen, %vlen, %clen;
    mov.u64 %jt, 0;
tmax_byte:
    setp.ge.u64 %p, %jt, %minlen;
    @%p bra tmax_lendiff;
    add.u64 %aaddr, %vbaddr, %jt;
    ld.global.u8 %abyte, [%aaddr];
    add.u64 %baddr, %caddr, %jt;
    ld.global.u8 %bbyte, [%baddr];
    setp.gt.u32 %pgt, %abyte, %bbyte;
    @%pgt bra tmax_cas;
    setp.lt.u32 %plt, %abyte, %bbyte;
    @%plt bra gb_mmdone;
    add.u64 %jt, %jt, 1;
    bra tmax_byte;
tmax_lendiff:
    setp.gt.u64 %pgt, %vlen, %clen;
    @%pgt bra tmax_cas;
    bra gb_mmdone;
tmax_cas:
    atom.global.cas.b64 %oldidx, [%addr], %curidx, %thisidx;
    setp.eq.u64 %p, %oldidx, %curidx;
    @%p bra gb_mmdone;
    bra tmax_loop;
gb_mmdone:
    add.u64 %i, %i, %stride;
    bra row_loop;
row_done:
    ret;
}
// Pass 2 of numeric MIN/MAX (LOCK-FREE). Pass 1 (the single-level kernel above) finalized each
// group's MIN/MAX HIGH limb in slot_min_hi/slot_max_hi and recorded each row's slot in row_slots.
// Here, for each row, if its high limb TIES the group's min-hi, fold its low limb into slot_min via
// atom.min.u64 (same for max). Result (hi:lo) = the exact signed-i128 min/max. No lock, no deadlock.
.visible .entry gpu_db_group_by_numeric_minmax_lo(
    .param .u64 resident_ptr,
    .param .u64 sum_byte_offset,
    .param .u64 indices_ptr,
    .param .u64 count,
    .param .u64 row_slots_ptr,
    .param .u64 slot_min_ptr,
    .param .u64 slot_max_ptr,
    .param .u64 slot_min_hi_ptr,
    .param .u64 slot_max_hi_ptr
)
{
    .reg .pred %p;
    .reg .pred %peq;
    .reg .u32 %t32;
    .reg .u32 %idx;
    .reg .u32 %slot32;
    .reg .u32 %vlo;
    .reg .u32 %vhi;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .s64 %val;
    .reg .s64 %valhi;
    .reg .s64 %cmhi;
    .reg .u64 %cmlo;
    .reg .u64 %base;
    .reg .u64 %soff;
    .reg .u64 %iptr;
    .reg .u64 %rsptr;
    .reg .u64 %mnptr;
    .reg .u64 %mxptr;
    .reg .u64 %mnhiptr;
    .reg .u64 %mxhiptr;
    .reg .u64 %count;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %h;
    .reg .u64 %off;
    .reg .u64 %voff;
    .reg .u64 %addr;

    ld.param.u64 %base, [resident_ptr];
    ld.param.u64 %soff, [sum_byte_offset];
    ld.param.u64 %iptr, [indices_ptr];
    ld.param.u64 %count, [count];
    ld.param.u64 %rsptr, [row_slots_ptr];
    ld.param.u64 %mnptr, [slot_min_ptr];
    ld.param.u64 %mxptr, [slot_max_ptr];
    ld.param.u64 %mnhiptr, [slot_min_hi_ptr];
    ld.param.u64 %mxhiptr, [slot_max_hi_ptr];
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
lo_loop:
    setp.ge.u64 %p, %i, %count;
    @%p bra lo_done;
    mul.lo.u64 %off, %i, 4;
    add.u64 %addr, %rsptr, %off;
    ld.global.u32 %slot32, [%addr];
    cvt.u64.u32 %h, %slot32;
    add.u64 %addr, %iptr, %off;
    ld.global.u32 %idx, [%addr];
    // numeric value at base + soff + idx*16 (4x4-byte) -> %val (low), %valhi (high)
    cvt.u64.u32 %voff, %idx;
    mul.lo.u64 %voff, %voff, 16;
    add.u64 %addr, %base, %soff;
    add.u64 %addr, %addr, %voff;
    ld.global.u32 %vlo, [%addr];
    ld.global.u32 %vhi, [%addr+4];
    mov.b64 %val, {%vlo, %vhi};
    ld.global.u32 %vlo, [%addr+8];
    ld.global.u32 %vhi, [%addr+12];
    mov.b64 %valhi, {%vlo, %vhi};
    mul.lo.u64 %off, %h, 8;
    // if valhi == slot_min_hi[h]: slot_min[h] = min(slot_min[h], val_lo)
    add.u64 %addr, %mnhiptr, %off;
    ld.global.s64 %cmhi, [%addr];
    setp.eq.s64 %peq, %valhi, %cmhi;
    add.u64 %addr, %mnptr, %off;
    @%peq atom.global.min.u64 %cmlo, [%addr], %val;
    // if valhi == slot_max_hi[h]: slot_max[h] = max(slot_max[h], val_lo)
    add.u64 %addr, %mxhiptr, %off;
    ld.global.s64 %cmhi, [%addr];
    setp.eq.s64 %peq, %valhi, %cmhi;
    add.u64 %addr, %mxptr, %off;
    @%peq atom.global.max.u64 %cmlo, [%addr], %val;
    add.u64 %i, %i, %stride;
    bra lo_loop;
lo_done:
    ret;
}
// Two-level GROUP BY: each block aggregates its rows into a SHARED-MEMORY local hash table (fast, no
// global contention), then merges the local table into the global table (one set of global atomics
// per local group, not per row). Kills the global-atomic contention the single-level kernel suffers
// at low cardinality. Local table NLOCAL=1024 (LMASK=1023). On local-table overflow a row spills
// directly to the global table (correctness for high cardinality; both contributions land in the
// same global slot for a key). Same params + same global table as the single-level kernel.
.visible .entry gpu_db_group_by_i32_count_sum_twolevel(
    .param .u64 resident_ptr,
    .param .u64 key_byte_offset,
    .param .u64 sum_byte_offset,
    .param .u64 indices_ptr,
    .param .u64 count,
    .param .u64 mask,
    .param .u64 slot_keys_ptr,
    .param .u64 slot_count_ptr,
    .param .u64 slot_sum_ptr,
    .param .u64 slot_min_ptr,
    .param .u64 slot_max_ptr
)
{
    // slot_min_ptr / slot_max_ptr are accepted for a uniform launch signature but UNUSED here: the
    // two-level kernel serves COUNT/SUM/AVG; grouped MIN/MAX routes to the single-level kernel.
    .shared .align 8 .b64 s_keys[1024];
    .shared .align 8 .b64 s_count[1024];
    .shared .align 8 .b64 s_sum[1024];

    .reg .pred %p;
    .reg .pred %hit;
    .reg .pred %full;
    .reg .pred %empty_slot;
    .reg .u32 %lane;
    .reg .u32 %bdim;
    .reg .u32 %bid;
    .reg .u32 %gdim;
    .reg .u32 %t32;
    .reg .u32 %j;
    .reg .u32 %probe;
    .reg .u32 %idx;
    .reg .u32 %sa;
    .reg .s32 %k32;
    .reg .s32 %v32;
    .reg .s64 %key;
    .reg .s64 %val;
    .reg .s64 %empty;
    .reg .s64 %cur;
    .reg .s64 %lkey;
    .reg .u64 %lcount;
    .reg .s64 %lsum;
    .reg .b64 %mix;
    .reg .b64 %tmp;
    .reg .u64 %base;
    .reg .u64 %iptr;
    .reg .u64 %kptr;
    .reg .u64 %cptr;
    .reg .u64 %sptr;
    .reg .u64 %count;
    .reg .u64 %mask;
    .reg .u64 %i;
    .reg .u64 %stride;
    .reg .u64 %h;
    .reg .u64 %off;
    .reg .u64 %addr;
    .reg .u64 %koff;
    .reg .u64 %soff;

    ld.param.u64 %base, [resident_ptr];
    ld.param.u64 %koff, [key_byte_offset];
    ld.param.u64 %soff, [sum_byte_offset];
    ld.param.u64 %iptr, [indices_ptr];
    ld.param.u64 %count, [count];
    ld.param.u64 %mask, [mask];
    ld.param.u64 %kptr, [slot_keys_ptr];
    ld.param.u64 %cptr, [slot_count_ptr];
    ld.param.u64 %sptr, [slot_sum_ptr];
    mov.s64 %empty, -9223372036854775808;
    mov.u32 %lane, %tid.x;
    mov.u32 %bdim, %ntid.x;
    mov.u32 %bid, %ctaid.x;
    mov.u32 %gdim, %nctaid.x;

    // Phase 0: init the shared local table (strided by blockDim).
    mov.u32 %j, %lane;
init_loop:
    setp.ge.u32 %p, %j, 1024;
    @%p bra init_done;
    mov.u32 %sa, s_keys;
    mad.lo.u32 %sa, %j, 8, %sa;
    st.shared.b64 [%sa], %empty;
    mov.u32 %sa, s_count;
    mad.lo.u32 %sa, %j, 8, %sa;
    st.shared.u64 [%sa], 0;
    mov.u32 %sa, s_sum;
    mad.lo.u32 %sa, %j, 8, %sa;
    st.shared.u64 [%sa], 0;
    add.u32 %j, %j, %bdim;
    bra init_loop;
init_done:
    bar.sync 0;

    // Phase 1: aggregate this block's rows into the shared local table (grid-stride).
    mad.lo.u32 %t32, %bid, %bdim, %lane;
    cvt.u64.u32 %i, %t32;
    mul.lo.u32 %t32, %gdim, %bdim;
    cvt.u64.u32 %stride, %t32;
row_loop:
    setp.ge.u64 %p, %i, %count;
    @%p bra phase2;
    mul.lo.u64 %off, %i, 4;
    add.u64 %addr, %iptr, %off;
    ld.global.u32 %idx, [%addr];
    cvt.u64.u32 %off, %idx;
    mul.lo.u64 %off, %off, 4;
    add.u64 %addr, %base, %koff;
    add.u64 %addr, %addr, %off;
    ld.global.s32 %k32, [%addr];
    cvt.s64.s32 %key, %k32;
    add.u64 %addr, %base, %soff;
    add.u64 %addr, %addr, %off;
    ld.global.s32 %v32, [%addr];
    cvt.s64.s32 %val, %v32;
    mov.b64 %mix, %key;
    shr.u64 %tmp, %mix, 33;
    xor.b64 %mix, %mix, %tmp;
    mul.lo.u64 %mix, %mix, 0xff51afd7ed558ccd;
    shr.u64 %tmp, %mix, 33;
    xor.b64 %mix, %mix, %tmp;
    mul.lo.u64 %mix, %mix, 0xc4ceb9fe1a85ec53;
    shr.u64 %tmp, %mix, 33;
    xor.b64 %mix, %mix, %tmp;
    and.b64 %h, %mix, 1023;
    mov.u32 %probe, 0;
local_probe:
    cvt.u32.u64 %j, %h;
    mov.u32 %sa, s_keys;
    mad.lo.u32 %sa, %j, 8, %sa;
    atom.shared.cas.b64 %cur, [%sa], %empty, %key;
    setp.eq.s64 %empty_slot, %cur, %empty;
    setp.eq.s64 %p, %cur, %key;
    or.pred %hit, %empty_slot, %p;
    @%hit bra local_hit;
    add.u64 %h, %h, 1;
    and.b64 %h, %h, 1023;
    add.u32 %probe, %probe, 1;
    setp.ge.u32 %full, %probe, 1024;
    @%full bra overflow;
    bra local_probe;
local_hit:
    mov.u32 %sa, s_count;
    mad.lo.u32 %sa, %j, 8, %sa;
    atom.shared.add.u64 %lcount, [%sa], 1;
    mov.u32 %sa, s_sum;
    mad.lo.u32 %sa, %j, 8, %sa;
    atom.shared.add.u64 %lcount, [%sa], %val;
    bra row_next;
overflow:
    and.b64 %h, %mix, %mask;
ov_probe:
    mul.lo.u64 %off, %h, 8;
    add.u64 %addr, %kptr, %off;
    atom.global.cas.b64 %cur, [%addr], %empty, %key;
    setp.eq.s64 %empty_slot, %cur, %empty;
    setp.eq.s64 %p, %cur, %key;
    or.pred %hit, %empty_slot, %p;
    @%hit bra ov_hit;
    add.u64 %h, %h, 1;
    and.b64 %h, %h, %mask;
    bra ov_probe;
ov_hit:
    add.u64 %addr, %cptr, %off;
    atom.global.add.u64 %lcount, [%addr], 1;
    add.u64 %addr, %sptr, %off;
    atom.global.add.u64 %lcount, [%addr], %val;
row_next:
    add.u64 %i, %i, %stride;
    bra row_loop;
phase2:
    bar.sync 0;
    // Phase 2: merge the shared local table into the global table (strided by blockDim).
    mov.u32 %j, %lane;
merge_loop:
    setp.ge.u32 %p, %j, 1024;
    @%p bra merge_done;
    mov.u32 %sa, s_keys;
    mad.lo.u32 %sa, %j, 8, %sa;
    ld.shared.b64 %lkey, [%sa];
    setp.eq.s64 %p, %lkey, %empty;
    @%p bra merge_next;
    mov.u32 %sa, s_count;
    mad.lo.u32 %sa, %j, 8, %sa;
    ld.shared.u64 %lcount, [%sa];
    mov.u32 %sa, s_sum;
    mad.lo.u32 %sa, %j, 8, %sa;
    ld.shared.u64 %lsum, [%sa];
    mov.b64 %mix, %lkey;
    shr.u64 %tmp, %mix, 33;
    xor.b64 %mix, %mix, %tmp;
    mul.lo.u64 %mix, %mix, 0xff51afd7ed558ccd;
    shr.u64 %tmp, %mix, 33;
    xor.b64 %mix, %mix, %tmp;
    mul.lo.u64 %mix, %mix, 0xc4ceb9fe1a85ec53;
    shr.u64 %tmp, %mix, 33;
    xor.b64 %mix, %mix, %tmp;
    and.b64 %h, %mix, %mask;
merge_probe:
    mul.lo.u64 %off, %h, 8;
    add.u64 %addr, %kptr, %off;
    atom.global.cas.b64 %cur, [%addr], %empty, %lkey;
    setp.eq.s64 %empty_slot, %cur, %empty;
    setp.eq.s64 %p, %cur, %lkey;
    or.pred %hit, %empty_slot, %p;
    @%hit bra merge_hit;
    add.u64 %h, %h, 1;
    and.b64 %h, %h, %mask;
    bra merge_probe;
merge_hit:
    add.u64 %addr, %cptr, %off;
    atom.global.add.u64 %lkey, [%addr], %lcount;
    add.u64 %addr, %sptr, %off;
    atom.global.add.u64 %lkey, [%addr], %lsum;
merge_next:
    add.u32 %j, %j, %bdim;
    bra merge_loop;
merge_done:
    ret;
}
