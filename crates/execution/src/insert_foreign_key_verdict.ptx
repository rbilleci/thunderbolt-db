    ld.global.u64 %rd24, [%rd4+24]; mov.u32 %r19, 2166136261; setp.eq.u32 %p4, %r18, 0;
    @%p4 bra PARENT_HASH_TEXT; setp.eq.u32 %p4, %r18, 4294967295; @%p4 bra PARENT_HASH_BOOL;
