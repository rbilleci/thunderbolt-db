    ld.global.u8 %r27, [%rd52]; ld.global.u8 %r28, [%rd53]; setp.ne.u32 %p18, %r27, %r28; @%p18 bra FINAL_ADVANCE;
    add.u64 %rd43, %rd43, 1; add.u64 %rd47, %rd47, 1; sub.u64 %rd49, %rd49, 1; bra FINAL_EXACT_TEXT_BYTE;
FINAL_EQUAL:
    setp.ne.u32 %p19, %r11, %r25; @%p19 bra FINAL_NEXT; mul.lo.u64 %rd40, %rd34, 4; add.u64 %rd41, %rd7, %rd40; add.u64 %rd40, %rd6, %rd40;
    ld.global.u32 %r26, [%rd40]; ld.global.u32 %r27, [%rd41]; setp.ne.u32 %p20, %r26, 0; setp.ne.u32 %p21, %r27, 0;
    @%p20 bra FINAL_CURRENT; @%p21 bra FINAL_HISTORY; atom.global.min.u32 %r28, [%rd16], %r11; bra FINAL_NEXT;
FINAL_CURRENT: @%p21 bra FINAL_NEXT;
