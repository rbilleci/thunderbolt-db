    mul.lo.u64 %rd36, %rd34, 8; add.u64 %rd37, %rd5, %rd36; ld.global.u64 %rd38, [%rd37];
    setp.eq.u64 %p8, %rd38, 0; @%p8 bra BAD_PROBE; shr.u64 %rd39, %rd38, 32; cvt.u32.u64 %r24, %rd39;
    setp.ne.u32 %p9, %r24, %r19; @%p9 bra FINAL_ADVANCE; cvt.u32.u64 %r25, %rd38; sub.u32 %r25, %r25, 1;
