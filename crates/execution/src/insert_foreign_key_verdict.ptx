    setp.gt.u64 %p15, %rd48, %rd24; @%p15 bra BAD_TEXT; sub.u64 %rd49, %rd44, %rd43;
    sub.u64 %rd50, %rd48, %rd47; setp.ne.u64 %p16, %rd49, %rd50; @%p16 bra BUILD_ADVANCE;
