BUILD_HASH_DONE:
    mul.wide.u32 %rd32, %r19, 2654435761; sub.u64 %rd33, %rd8, 1; and.b64 %rd34, %rd32, %rd33;
    mov.u64 %rd35, 0;
BUILD_PROBE:
    mul.lo.u64 %rd36, %rd34, 8; add.u64 %rd37, %rd5, %rd36; ld.global.u64 %rd38, [%rd37];
    setp.eq.u64 %p8, %rd38, 0; @%p8 bra BUILD_EMPTY;
BUILD_PRESENT:
    shr.u64 %rd39, %rd38, 32; cvt.u32.u64 %r24, %rd39; setp.ne.u32 %p9, %r24, %r19;
    @%p9 bra BUILD_ADVANCE;
    cvt.u32.u64 %r25, %rd38; sub.u32 %r25, %r25, 1; setp.ge.u32 %p10, %r25, %r3;
    @%p10 bra BAD_REPRESENTATIVE;
    // Exact typed equality: current child row versus the candidate representative.
    setp.eq.u32 %p11, %r18, 0; @%p11 bra BUILD_EXACT_TEXT;
    setp.eq.u32 %p11, %r18, 4294967295; @%p11 bra BUILD_EXACT_BOOL;
    cvt.u64.u32 %rd40, %r18; cvt.u64.u32 %rd41, %r11; mul.lo.u64 %rd41, %rd41, %rd40;
    mul.lo.u64 %rd41, %rd41, 4; add.u64 %rd42, %rd1, %rd22; add.u64 %rd42, %rd42, %rd41;
    cvt.u64.u32 %rd43, %r25; mul.lo.u64 %rd43, %rd43, %rd40; mul.lo.u64 %rd43, %rd43, 4;
    add.u64 %rd44, %rd1, %rd22; add.u64 %rd44, %rd44, %rd43; mov.u32 %r26, 0;
BUILD_EXACT_FIXED:
    setp.ge.u32 %p12, %r26, %r18; @%p12 bra BUILD_EQUAL;
    mul.wide.u32 %rd45, %r26, 4; add.u64 %rd46, %rd42, %rd45; add.u64 %rd47, %rd44, %rd45;
    ld.global.u32 %r27, [%rd46]; ld.global.u32 %r28, [%rd47]; setp.ne.u32 %p13, %r27, %r28;
