    mul.wide.u32 %rd17, %r14, 32; add.u64 %rd18, %rd4, %rd17; ld.global.u64 %rd19, [%rd18];
    shr.u32 %r15, %r11, 3; and.b32 %r16, %r11, 7; cvt.u64.u32 %rd20, %r15;
    add.u64 %rd21, %rd3, %rd19; add.u64 %rd21, %rd21, %rd20; ld.global.u8 %r17, [%rd21];
    shr.u32 %r17, %r17, %r16; and.b32 %r17, %r17, 1; setp.eq.u32 %p3, %r17, 0; @%p3 bra PARENT_NEXT;
    add.u32 %r14, %r14, 1; bra PARENT_VALIDITY;
PARENT_HASH_LOAD:
