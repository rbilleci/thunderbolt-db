    ld.global.u64 %rd28, [%rd27]; ld.global.u64 %rd29, [%rd27+8]; setp.gt.u64 %p6, %rd28, %rd29; @%p6 bra BAD_TEXT;
    setp.gt.u64 %p6, %rd29, %rd24; @%p6 bra BAD_TEXT; add.u64 %rd30, %rd1, %rd23; mov.u32 %r20, 2166136261;
