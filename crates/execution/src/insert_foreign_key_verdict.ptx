.version 6.0
.target sm_30
.address_size 64

// One directory word is `(fingerprint << 32) | (stable_child_representative + 1)`.
// Modes: 0 build child representatives, 1 scan one MVCC parent shard, 2 finalize children,
// 3 scan the optional same-batch provider (which marks both worlds).
.visible .entry gpu_db_insert_foreign_key_verdict(
    .param .u64 child_base, .param .u64 child_desc, .param .u32 child_data_count,
    .param .u32 child_desc_count, .param .u32 child_rows,
    .param .u64 parent_base, .param .u64 parent_desc, .param .u32 parent_data_count,
    .param .u32 parent_desc_count, .param .u32 parent_rows,
    .param .u64 directory, .param .u64 current_matches, .param .u64 original_matches,
    .param .u64 slot_count, .param .u64 created_ptr, .param .u64 created_default,
    .param .u64 deleted_ptr, .param .u64 deleted_default, .param .u64 deleted_live,
    .param .u64 constraint_boundary, .param .u64 original_snapshot,
    .param .u64 terminal, .param .u32 mode)
{
    .reg .pred %p<48>;
    .reg .b32 %r<96>;
    .reg .b64 %rd<112>;

    ld.param.u64 %rd1, [child_base]; ld.param.u64 %rd2, [child_desc];
    ld.param.u32 %r1, [child_data_count]; ld.param.u32 %r2, [child_desc_count];
    ld.param.u32 %r3, [child_rows]; ld.param.u64 %rd3, [parent_base];
    ld.param.u64 %rd4, [parent_desc]; ld.param.u32 %r4, [parent_data_count];
    ld.param.u32 %r5, [parent_desc_count]; ld.param.u32 %r6, [parent_rows];
    ld.param.u64 %rd5, [directory]; ld.param.u64 %rd6, [current_matches];
    ld.param.u64 %rd7, [original_matches]; ld.param.u64 %rd8, [slot_count];
    ld.param.u64 %rd9, [created_ptr]; ld.param.u64 %rd10, [created_default];
    ld.param.u64 %rd11, [deleted_ptr]; ld.param.u64 %rd12, [deleted_default];
    ld.param.u64 %rd13, [deleted_live]; ld.param.u64 %rd14, [constraint_boundary];
    ld.param.u64 %rd15, [original_snapshot]; ld.param.u64 %rd16, [terminal];
    ld.param.u32 %r7, [mode];

    mov.u32 %r8, %tid.x; mov.u32 %r9, %ctaid.x; mov.u32 %r10, %ntid.x;
    mad.lo.u32 %r11, %r9, %r10, %r8; mov.u32 %r12, %nctaid.x;
    mul.lo.u32 %r13, %r12, %r10;
    setp.eq.u32 %p1, %r7, 0; @%p1 bra BUILD_START;
    setp.eq.u32 %p1, %r7, 2; @%p1 bra FINAL_START;
    bra PARENT_START;

// The three child paths share the same MATCH SIMPLE NULL check and descriptor ABI.  Data count
// is prevalidated to exactly one; any validity suffix component null satisfies the child key.
BUILD_START:
    setp.ge.u32 %p1, %r11, %r3; @%p1 bra DONE;
BUILD_ROW:
    setp.ge.u32 %p1, %r11, %r3; @%p1 bra DONE;
    mov.u32 %r14, %r1;
BUILD_VALIDITY:
    setp.ge.u32 %p2, %r14, %r2; @%p2 bra BUILD_HASH_LOAD;
    mul.wide.u32 %rd17, %r14, 32; add.u64 %rd18, %rd2, %rd17;
    ld.global.u64 %rd19, [%rd18]; shr.u32 %r15, %r11, 3; and.b32 %r16, %r11, 7;
    cvt.u64.u32 %rd20, %r15; add.u64 %rd21, %rd1, %rd19; add.u64 %rd21, %rd21, %rd20;
    ld.global.u8 %r17, [%rd21]; shr.u32 %r17, %r17, %r16; and.b32 %r17, %r17, 1;
    setp.eq.u32 %p3, %r17, 0; @%p3 bra BUILD_NEXT;
    add.u32 %r14, %r14, 1; bra BUILD_VALIDITY;
BUILD_HASH_LOAD:
    ld.global.u64 %rd22, [%rd2]; ld.global.u32 %r18, [%rd2+8];
    ld.global.u64 %rd23, [%rd2+16]; ld.global.u64 %rd24, [%rd2+24];
    mov.u32 %r19, 2166136261; setp.eq.u32 %p4, %r18, 0; @%p4 bra BUILD_HASH_TEXT;
    setp.eq.u32 %p4, %r18, 4294967295; @%p4 bra BUILD_HASH_BOOL;
    cvt.u64.u32 %rd25, %r18; cvt.u64.u32 %rd26, %r11;
    mul.lo.u64 %rd26, %rd26, %rd25; mul.lo.u64 %rd26, %rd26, 4;
    add.u64 %rd27, %rd1, %rd22; add.u64 %rd27, %rd27, %rd26; mov.u32 %r20, 0;
BUILD_HASH_FIXED:
    setp.ge.u32 %p5, %r20, %r18; @%p5 bra BUILD_HASH_DONE;
    mul.wide.u32 %rd28, %r20, 4; add.u64 %rd29, %rd27, %rd28; ld.global.u32 %r21, [%rd29];
    xor.b32 %r19, %r19, %r21; mul.lo.u32 %r19, %r19, 16777619;
    shl.b32 %r22, %r19, 13; shr.b32 %r23, %r19, 19; or.b32 %r19, %r22, %r23;
    add.u32 %r19, %r19, 2654435761; add.u32 %r20, %r20, 1; bra BUILD_HASH_FIXED;
BUILD_HASH_BOOL:
    shr.u32 %r20, %r11, 3; and.b32 %r21, %r11, 7; cvt.u64.u32 %rd25, %r20;
    add.u64 %rd26, %rd1, %rd22; add.u64 %rd26, %rd26, %rd25; ld.global.u8 %r22, [%rd26];
    shr.u32 %r22, %r22, %r21; and.b32 %r22, %r22, 1; xor.b32 %r19, %r19, %r22;
    mul.lo.u32 %r19, %r19, 16777619; shl.b32 %r22, %r19, 13; shr.b32 %r23, %r19, 19;
    or.b32 %r19, %r22, %r23; add.u32 %r19, %r19, 2654435761; bra BUILD_HASH_DONE;
BUILD_HASH_TEXT:
    mul.wide.u32 %rd25, %r11, 8; add.u64 %rd26, %rd1, %rd22; add.u64 %rd27, %rd26, %rd25;
    ld.global.u64 %rd28, [%rd27]; ld.global.u64 %rd29, [%rd27+8];
    setp.gt.u64 %p6, %rd28, %rd29; @%p6 bra BAD_TEXT;
    setp.gt.u64 %p6, %rd29, %rd24; @%p6 bra BAD_TEXT;
    add.u64 %rd30, %rd1, %rd23; mov.u32 %r20, 2166136261;
BUILD_HASH_TEXT_BYTE:
    setp.ge.u64 %p7, %rd28, %rd29; @%p7 bra BUILD_HASH_TEXT_DONE;
    add.u64 %rd31, %rd30, %rd28; ld.global.u8 %r21, [%rd31]; xor.b32 %r20, %r20, %r21;
    mul.lo.u32 %r20, %r20, 16777619; add.u64 %rd28, %rd28, 1; bra BUILD_HASH_TEXT_BYTE;
BUILD_HASH_TEXT_DONE:
    xor.b32 %r19, %r19, %r20; mul.lo.u32 %r19, %r19, 16777619;
    shl.b32 %r22, %r19, 13; shr.b32 %r23, %r19, 19; or.b32 %r19, %r22, %r23;
