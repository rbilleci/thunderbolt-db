    ld.global.u64 %rd43, [%rd42]; ld.global.u64 %rd44, [%rd42+8];
    setp.gt.u64 %p14, %rd43, %rd44; @%p14 bra BAD_TEXT; setp.gt.u64 %p14, %rd44, %rd24; @%p14 bra BAD_TEXT;
    mul.wide.u32 %rd45, %r25, 8; add.u64 %rd46, %rd41, %rd45; ld.global.u64 %rd47, [%rd46];
